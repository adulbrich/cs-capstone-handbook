# Refuse to install under a Node version outside package.json "engines".
# Without this, engines is advisory only and a wrong Node fails later, at build.
engine-strict=true

# 260+ transitive packages print funding notices on every install.
fund=false

# Prefer a single shared copy of a transitive dep over duplicated nested ones.
# Keeps the tree smaller and means one advisory maps to one version to patch.
prefer-dedupe=true
