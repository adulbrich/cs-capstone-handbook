---
/**
 * ActivityBadge: one badge of an activity's badge line, shared by
 * `ActivityMeta.astro`, which renders the line, and `BadgeLegend.astro`,
 * which shows each kind once beside what it means, so the two cannot look
 * different.
 *
 * Each kind has one color and keeps it: Workshop is green, the color of
 * Starlight's `success` badge variant; Prepares is blue, `note`'s; Whole team
 * and the effort are neutral gray. Starlight's `Badge` takes no icon, no
 * `href`, and no neutral variant, so this draws its own pill from the same
 * hues, its fill and border softened toward the page background, with dark
 * text in the light theme as the site's `.who-tag` has.
 *
 * With `href` the pill is the link. `srPrefix` is text only a screen reader
 * gets, placed before the visible text, so a Prepares link announces itself
 * as one rather than as a link to the assignment.
 */
import { Icon } from "@astrojs/starlight/components";

interface Props {
  /** Makes the badge a link. A linked Workshop badge shows an arrow. */
  href?: string;
  /** Which badge: sets the color and the icon. */
  kind: "effort" | "prepares" | "team" | "workshop";
  /** Screen-reader-only text placed before `text`. */
  srPrefix?: string;
  /** The visible text. */
  text: string;
}

const { href, kind, srPrefix, text } = Astro.props;
const Tag = href ? "a" : "span";
---

<Tag class:list={["activity-badge", `activity-badge--${kind}`]} href={href}>
  {
    kind === "team" && (
      <svg
        aria-hidden="true"
        fill="none"
        height="1em"
        stroke="currentColor"
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        viewBox="0 0 24 24"
        width="1em"
      >
        <circle cx="9" cy="7" r="4" />
        <path d="M2 21v-2a4 4 0 0 1 4-4h6a4 4 0 0 1 4 4v2" />
        <path d="M16 3.13a4 4 0 0 1 0 7.75" />
        <path d="M22 21v-2a4 4 0 0 0-3-3.87" />
      </svg>
    )
  }
  {kind === "effort" && <Icon name="clock" size="1em" />}
  {
    kind === "workshop" && (
      <svg
        aria-hidden="true"
        fill="none"
        height="1em"
        stroke="currentColor"
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        viewBox="0 0 24 24"
        width="1em"
      >
        <path d="M22 10 12 5 2 10l10 5 10-5Z" />
        <path d="M6 12v5c3 3 9 3 12 0v-5" />
        <path d="M22 10v6" />
      </svg>
    )
  }
  <span>{srPrefix && <span class="sr-only">{srPrefix}</span>}{text}</span>
  {kind === "workshop" && href && <Icon name="right-arrow" size="1em" />}
</Tag>

<style>
  .activity-badge {
    --activity-badge-text: var(--sl-color-gray-2);
    --activity-badge-bg: var(--sl-color-gray-6);
    --activity-badge-border: var(--sl-color-gray-4);
    display: inline-flex;
    align-items: center;
    gap: 0.3em;
    padding: 0.0625rem 0.45rem;
    border: 1px solid var(--activity-badge-border);
    border-radius: 0.375rem;
    background-color: var(--activity-badge-bg);
    color: var(--activity-badge-text);
    font-family: var(--sl-font);
    font-size: var(--sl-text-sm);
    line-height: 1.6;
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  .activity-badge :global(svg) {
    flex-shrink: 0;
  }

  .activity-badge--workshop {
    --activity-badge-text: var(--sl-color-green-high);
    --activity-badge-bg: color-mix(
      in srgb,
      var(--sl-color-green-low) 60%,
      var(--sl-color-bg)
    );
    --activity-badge-border: color-mix(
      in srgb,
      var(--sl-color-green) 60%,
      var(--sl-color-bg)
    );
  }

  .activity-badge--prepares {
    --activity-badge-text: var(--sl-color-blue-high);
    --activity-badge-bg: color-mix(
      in srgb,
      var(--sl-color-blue-low) 60%,
      var(--sl-color-bg)
    );
    --activity-badge-border: color-mix(
      in srgb,
      var(--sl-color-blue) 60%,
      var(--sl-color-bg)
    );
  }

  a.activity-badge {
    transition: background-color 0.15s;
  }

  /* Mixing in the border color tints each kind toward its own hue without
     naming a color. At 20% the dark-theme Workshop badge fell to 4.8:1
     contrast; 15% keeps every kind above 5.3:1 in both themes. */
  a.activity-badge:hover {
    background-color: color-mix(
      in srgb,
      var(--activity-badge-bg),
      var(--activity-badge-border) 15%
    );
  }

  a.activity-badge:focus-visible {
    outline: 2px solid var(--sl-color-text-accent);
    outline-offset: 2px;
  }
</style>
