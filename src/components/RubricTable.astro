---
import { parseRubricCsv, rubricTotal } from "../lib/rubric-csv.mjs";
import "../styles/rubric-skin.css";

/**
 * RubricTable: renders an assignment's rubric from the Canvas rubric CSV.
 *
 * The CSV under `canvas/assignments/<dir>/` is the single source of truth for
 * every rubric (#144). It is what Canvas's own rubric import reads, and this
 * component renders the same file on the handbook page, so the two cannot
 * drift. Nothing here is hand-maintained alongside it.
 *
 * The format, Canvas's rubric import template, is documented and parsed in
 * `src/lib/rubric-csv.mjs`. One file is one rubric; the parser returns its
 * criteria, each with its outcome tags split out of the title, and any number
 * of rating bands, so `defense` and its fourth `Missing` band need nothing
 * special here.
 *
 * Accessibility notes:
 * - A real <table> with a <caption> and header cells, so a screen reader can
 *   announce the criterion a rating belongs to instead of reading loose text.
 * - Each rating's points and band name are text, never conveyed by color or
 *   position alone.
 * - The table skin, colors included, is `src/styles/rubric-skin.css`,
 *   shared with RubricCriterion.
 * - Outcome tags are rendered as text in their own labelled cell. They are the
 *   accreditation record and must survive being read aloud.
 *
 * Usage in MDX:
 *
 *   import RubricTable from '/src/components/RubricTable.astro';
 *   import rubricCsv from '/canvas/assignments/rfc/rfc-final-rubric.csv?raw';
 *
 *   <RubricTable csv={rubricCsv} sourceLabel="canvas/assignments/rfc/rfc-final-rubric.csv" />
 *
 * `?raw` is a Vite feature and needs no Astro configuration. A missing file
 * fails the build; `scripts/validate-outcomes.mjs` catches the other half,
 * which is a page importing a CSV that belongs to a different assignment.
 */
interface Props {
  /** The CSV file's contents, imported with `?raw`. */
  csv: string;
  /** Repository-relative path, used in error messages and checked by the validator. */
  sourceLabel: string;
}

const { csv, sourceLabel } = Astro.props;

const { criteria } = parseRubricCsv(csv, sourceLabel);
const totalPoints = rubricTotal(criteria);
---

<div class="rubric rubric-skin not-content">
  <table>
    <caption>
      Rubric: {totalPoints} points across {
        criteria.length
      } criteria
    </caption>
    <thead>
      <tr>
        <th scope="col" class="rubric__criterion-col">Criterion</th>
        <th scope="col">Ratings</th>
      </tr>
    </thead>
    <tbody>
      {
        criteria.map((c) => (
          <tr>
            <th scope="row">
              <span class="rubric__title">{c.title}</span>
              {c.description && (
                <span class="rubric__description">{c.description}</span>
              )}
              <span class="rubric__points">
                {c.maxPoints} points
              </span>
              {c.tags.length > 0 && (
                <span class="rubric__tags">
                  <span class="rubric__tags-label">Outcomes: </span>
                  {c.tags.join(", ")}
                </span>
              )}
            </th>
            <td>
              <ul
                class:list={[
                  "rubric__ratings",
                  { "rubric__ratings--stacked": c.ratings.length > 4 },
                ]}
              >
                {c.ratings.map((r) => (
                  <li>
                    <span class="rubric__band">
                      {r.name} ({r.points})
                    </span>
                    {r.description && (
                      <span class="rubric__band-description">
                        {r.description}
                      </span>
                    )}
                  </li>
                ))}
              </ul>
            </td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>

<style>
  .rubric__criterion-col {
    width: 30%;
    min-width: 11rem;
  }

  .rubric__title,
  .rubric__description,
  .rubric__points,
  .rubric__tags {
    display: block;
  }

  .rubric__title {
    font-weight: 600;
    color: var(--sl-color-white);
  }

  .rubric__description {
    margin-block-start: 0.35rem;
    color: var(--sl-color-gray-2);
  }

  .rubric__points {
    margin-block-start: 0.5rem;
    font-weight: 600;
    color: var(--sl-color-white);
  }

  .rubric__tags {
    margin-block-start: 0.2rem;
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
  }

  /*
   * Bands sit side by side only where each one has room to read. `auto-fit`
   * with a floor measures the cell rather than the viewport, which matters
   * because Starlight's content column is far narrower than the window: a
   * viewport media query put four bands into a 30rem column and wrapped every
   * label onto three lines.
   */
  .rubric__ratings {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    gap: 0.75rem 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /*
   * More than four bands is an ordered scale read top to bottom: the survey
   * rubrics' five points and the spring outcome ladder's six rungs. A grid
   * puts two bands on a line and the reading order zigzags.
   */
  .rubric__ratings--stacked {
    grid-template-columns: 1fr;
  }

  .rubric__band,
  .rubric__band-description {
    display: block;
  }

  .rubric__band {
    font-weight: 600;
    color: var(--sl-color-white);
  }

  .rubric__band-description {
    margin-block-start: 0.2rem;
    color: var(--sl-color-gray-2);
  }

  @media (prefers-contrast: more) {
    .rubric__description,
    .rubric__band-description,
    .rubric__tags {
      color: var(--sl-color-white);
    }
  }
</style>
