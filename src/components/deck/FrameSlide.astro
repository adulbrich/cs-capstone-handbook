---
// A live page as the slide, full bleed: an interactive map or a demo the
// presenter can point at, served from this site. reveal.js loads the frame
// when the slide comes up and unloads it after, so a heavy page costs nothing
// until then. `src` is a root-relative path; `label` names the frame for
// screen readers. The slot takes <Notes>.
//
//   <FrameSlide src="/decks/auditorium-seating.html?slide"
//     label="Auditorium seating map by team number">
//     <Notes time="1:00">...</Notes>
//   </FrameSlide>
//
// Other attributes land on the <section>.
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"section"> {
  label: string;
  src: string;
}

const { class: className, label, src, ...attrs } = Astro.props;
---

<section class:list={["deck-slide", "deck-frame-slide", className]} {...attrs}>
  <iframe data-src={src} title={label}></iframe>
  <slot />
</section>

<style>
  iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>
