---
// A team's upcoming decisions, each marked hard to reverse or easy to
// reverse, as Map Your Hard-to-Reverse Decisions sorts them; for a
// <Slide wide>. A hard-to-reverse decision may carry its validator: who
// checks it, and what they check, before the team commits.
//
//   <DecisionList
//     decisions={[
//       { text: "Where the database lives", hard: true,
//         validator: { who: "Partner", what: "the hosting it already pays for" } },
//       { text: "Chart library for the dashboard" },
//     ]}
//   />
//
// A decision without `hard` is easy to reverse. The count under the list
// ("1 of 2 hard to reverse") is the activity's check that the hard ones are
// few; `count={false}` drops it. With `stepped`, the list shows first and
// the marks, validators, and count appear together on the next arrow press,
// in the order the activity runs: write the decisions down, then classify.
// Ten decisions is the activity's list and the most a slide holds, so an
// eleventh fails the build, as does a validator on an easy-to-reverse one.
interface Decision {
  hard?: boolean;
  text: string;
  validator?: { what: string; who: string };
}

interface Props {
  count?: boolean;
  decisions: Decision[];
  stepped?: boolean;
}

const MAX_DECISIONS = 10;
const { count = true, decisions, stepped = false } = Astro.props;

if (decisions.length === 0 || decisions.length > MAX_DECISIONS) {
  throw new Error(
    `<DecisionList>: ${decisions.length} decisions; use 1 to ${MAX_DECISIONS}.`
  );
}
for (const decision of decisions) {
  if (decision.validator && !decision.hard) {
    throw new Error(
      `<DecisionList>: "${decision.text}" has a validator and is easy to reverse; only a hard-to-reverse decision gets one.`
    );
  }
}

const hardCount = decisions.filter((decision) => decision.hard).length;
const hasValidators = decisions.some((decision) => decision.validator);
// Everything the classification adds, revealed on one press when stepped.
const step = stepped ? { class: "fragment", "data-fragment-index": 0 } : {};
---

<div class:list={["decision-list", { "with-validators": hasValidators }]}>
  <table>
    <thead>
      <tr>
        <th scope="col" class="mark-col">To reverse</th>
        <th scope="col">Decision</th>
        {hasValidators && <th scope="col">Validator: who checks, and what</th>}
      </tr>
    </thead>
    <tbody>
      {
        decisions.map((decision) => (
          <tr class:list={{ hard: decision.hard }}>
            <td>
              <span class:list={["mark", step.class]} data-fragment-index={step["data-fragment-index"]}>
                {decision.hard ? "Hard" : "Easy"}
              </span>
            </td>
            <td class="text">{decision.text}</td>
            {hasValidators && (
              <td class="validator">
                {decision.validator && (
                  <span class={step.class} data-fragment-index={step["data-fragment-index"]}>
                    <strong>{decision.validator.who}:</strong> {decision.validator.what}
                  </span>
                )}
              </td>
            )}
          </tr>
        ))
      }
    </tbody>
  </table>
  {
    count && (
      <p class:list={["count", step.class]} data-fragment-index={step["data-fragment-index"]}>
        {hardCount} of {decisions.length} hard to reverse
      </p>
    )
  }
</div>

<style>
  .decision-list {
    font-size: var(--deck-text-min);
    line-height: 1.15;
  }

  table {
    width: 100%;
    table-layout: fixed;
    border-collapse: collapse;
  }

  .mark-col {
    width: 190px;
  }

  .with-validators th:nth-child(2) {
    width: 46%;
  }

  th {
    padding: 0 16px 6px 0;
    font-weight: 750;
    color: var(--deck-ink-soft);
    text-align: start;
  }

  td {
    padding: 4px 16px 4px 0;
    vertical-align: top;
    border-block-start: 2px solid var(--deck-rule);
  }

  .mark {
    display: inline-block;
    min-width: 130px;
    padding: 0 14px;
    font-weight: 700;
    text-align: center;
    color: var(--deck-ink-soft);
    background: var(--deck-card);
    border: 2px solid var(--deck-rule);
    border-radius: 999px;
  }

  .hard .mark {
    color: var(--deck-accent-ink);
    background: var(--deck-accent-wash);
    border-color: var(--deck-accent);
  }

  .validator {
    color: var(--deck-ink-soft);
  }

  .validator strong {
    color: var(--deck-ink);
  }

  .count {
    margin: 10px 0 0;
    font-weight: 750;
    color: var(--deck-accent-ink);
  }
</style>
