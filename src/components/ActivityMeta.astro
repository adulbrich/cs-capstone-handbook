---
import { getCollection } from "astro:content";
/**
 * ActivityMeta: the badge line under every activity heading, generated from
 * the assignment pages so it cannot drift from them.
 *
 * Two rows. The first says what the activity costs: `Whole team` when it
 * fails without everyone present; `Effort: <value>`, on the fixed scale in
 * `src/lib/activity-links.mjs`; and a `Workshop N, <term>` badge linking the
 * activity's `### Workshop N:` section on the workshop page. The second says
 * what it serves: a `Helps with` label, then one badge per assignment whose
 * "Activities That Prepare This" section links the activity, each linking
 * that section.
 * A row with nothing in it is left out, and an activity with nothing renders
 * nothing.
 *
 * Usage in MDX, on the line after the blank line under the heading:
 *
 *   import ActivityMeta from '/src/components/ActivityMeta.astro';
 *
 *   <ActivityMeta anchor="lean-canvas" effort="30 min" wholeTeam />
 *
 * `anchor` is the heading's slug; `scripts/validate-activities.mjs` checks
 * it matches, and that `effort` is on the scale. `page` names the activity's
 * page when the line is shown somewhere else, as the legend's example is;
 * the validator checks that copy against the activity's own line.
 */
import {
  activityKey,
  cachedActivityIndex,
  EFFORT_SCALE,
  PREP_ANCHOR,
  WORKSHOP_PAGE_ID,
} from "../lib/activity-links.mjs";
import ActivityBadge from "./ActivityBadge.astro";

interface Props {
  /** The activity heading's anchor, as `lean-canvas`. */
  anchor: string;
  /** One value from the effort scale, as `30 min`. */
  effort?: string;
  /** The activity's page, as `requirements`; defaults to the current one. */
  page?: string;
  /** Set when the activity fails without the whole team present. */
  wholeTeam?: boolean;
}

const { anchor, effort, wholeTeam = false } = Astro.props;
const { entry } = Astro.locals.starlightRoute;
const page = Astro.props.page ?? entry.id.replace(/^activities\//, "");
if (effort && !EFFORT_SCALE.includes(effort)) {
  throw new Error(
    `ActivityMeta: ${page}#${anchor} on ${entry.id} has effort "${effort}", which is not one of ${EFFORT_SCALE.join(", ")}`
  );
}

const assignments = await getCollection("docs", (d) =>
  d.id.startsWith("assignments/")
);
const index = cachedActivityIndex(
  assignments.map((d) => `${d.id}:${d.digest}`).join(),
  () => ({
    assignments: assignments.map((d) => ({
      body: d.body ?? "",
      id: d.id,
      order: d.data.sidebar?.order,
      title: d.data.title,
    })),
    workshopSource:
      assignments.find((d) => d.id === WORKSHOP_PAGE_ID)?.body ?? "",
  })
);

interface Entry {
  prepares: { id: string; title: string }[];
  workshop: { n: number; slug: string; term: string } | null;
}
const found: Entry | undefined = index.get(activityKey(page, anchor));
const prepares = found?.prepares ?? [];
const workshop = found?.workshop ?? null;
const term = workshop
  ? workshop.term[0].toUpperCase() + workshop.term.slice(1)
  : null;
const hasCost = wholeTeam || effort || workshop;
---

{
  (hasCost || prepares.length > 0) && (
    <div class="activity-meta not-content">
      {hasCost && (
        <div class="activity-meta__row">
          {wholeTeam && <ActivityBadge kind="team" text="Whole team" />}
          {effort && <ActivityBadge kind="effort" text={`Effort: ${effort}`} />}
          {workshop && (
            <ActivityBadge
              href={`/${WORKSHOP_PAGE_ID}/#${workshop.slug}`}
              kind="workshop"
              text={`Workshop ${workshop.n}, ${term}`}
            />
          )}
        </div>
      )}
      {prepares.length > 0 && (
        <div class="activity-meta__row">
          <span class="activity-meta__label">Helps with</span>
          {prepares.map((a) => (
            <ActivityBadge
              href={`/${a.id}/#${PREP_ANCHOR}`}
              kind="prepares"
              srPrefix="Helps with "
              text={a.title}
            />
          ))}
        </div>
      )}
    </div>
  )
}

<style>
  .activity-meta {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .activity-meta__row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.375rem;
  }

  .activity-meta__label {
    margin-inline-end: 0.125rem;
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-sm);
  }
</style>
