---
interface Props {
  count: number;
}

const { count } = Astro.props;
---

<div id="indicators" class="absolute bottom-4 left-1/2 -translate-x-1/2">
  {
    Array.from({ length: count }).map((_, index) => (
      <button
        class={`indicator h-6 w-6 rounded-full bg-clip-content p-2 md:p-1.5 ${index === 0 ? "bg-white/80" : "bg-white/50"}`}
        data-slide-index={index}
        aria-label={`Go to slide ${index + 1}`}
      />
    ))
  }
</div>
