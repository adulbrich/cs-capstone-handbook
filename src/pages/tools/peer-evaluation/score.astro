---
// Score the peer evaluation (#463). The rubrics are read at build time;
// the export, the roster, and the rubric export are read in the browser
// only.
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import PeerScore from "../../../components/tools/peer/PeerScore.svelte";
import { byInstrument } from "../../../components/tools/peer/peer-rubrics.mjs";
import { pages } from "../../../data/peer-tools.mjs";
---

<StarlightPage
  frontmatter={{
    description: pages.score.description,
    editUrl: false,
    head: [{ attrs: { content: "noindex", name: "robots" }, tag: "meta" }],
    pagefind: false,
    tableOfContents: false,
    title: pages.score.title,
  }}
>
  <p>{pages.score.intro}</p>
  <PeerScore client:only="svelte" rubrics={byInstrument} />
</StarlightPage>
