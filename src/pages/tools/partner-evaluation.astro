---
// The project partner survey scorer (#445). The rubrics and the A lower bound
// are parsed here, at build time, from the files the handbook renders, so the
// page can never carry a second copy of a rating name or a point value. The
// component reads the three exports in the browser only.
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import fallCsv from "/canvas/assignments/project-partner-evaluation/partner-final-fall-rubric.csv?raw";
import springCsv from "/canvas/assignments/project-partner-evaluation/partner-final-spring-rubric.csv?raw";
import winterCsv from "/canvas/assignments/project-partner-evaluation/partner-final-winter-rubric.csv?raw";
import pulseCsv from "/canvas/assignments/project-partner-evaluation/partner-pulse-rubric.csv?raw";
import gradingMdx from "/src/content/docs/learning-objectives/grading.mdx?raw";
import PartnerEvaluationScorer from "../../components/tools/PartnerEvaluationScorer.svelte";
import { parseRubricCsv } from "../../lib/rubric-csv.mjs";
import { aLowerBound } from "../../lib/tools/partner-scoring.mjs";

const rubrics = {
  fall: parseRubricCsv(fallCsv, "partner-final-fall-rubric.csv"),
  pulse: parseRubricCsv(pulseCsv, "partner-pulse-rubric.csv"),
  spring: parseRubricCsv(springCsv, "partner-final-spring-rubric.csv"),
  winter: parseRubricCsv(winterCsv, "partner-final-winter-rubric.csv"),
};
const aBound = aLowerBound(gradingMdx);
---

<StarlightPage
  frontmatter={{
    description:
      "Score the project partner surveys into a Canvas rubric-assessment CSV.",
    editUrl: false,
    head: [{ attrs: { content: "noindex", name: "robots" }, tag: "meta" }],
    pagefind: false,
    title: "Project Partner Evaluation Scorer",
  }}
>
  <p>
    Drop the three files, check the survey, and Run. The files are read in
    your browser and never uploaded. The Midterm Pulse is scored; the
    End-of-Term Survey is recognized but not scored yet.
  </p>

  <h2>Where the inputs come from</h2>
  <ol>
    <li>
      <strong>Roster with groups</strong>: in Canvas, People, Groups, export
      the group set's roster as CSV (<code>name, canvas_user_id, user_id,
      login_id, sections, group_name, canvas_group_id, group_id</code>).
    </li>
    <li>
      <strong>Rubric assessments</strong>: in the Gradebook, export the rubric
      assessments of the assignment this survey grades (<code>Student Id,
      Student Name</code>, then <code>Rating</code>, <code>Points</code>, and <code>Comments</code>
      per criterion). The criteria must be the ones in
      the assignment's rubric.
    </li>
    <li>
      <strong>Qualtrics responses</strong>: in Data &amp; Analysis, Export
      &amp; Import, Export Data, CSV, with "Use choice text" on. The file keeps
      its three header rows.
    </li>
  </ol>

  <PartnerEvaluationScorer client:only="svelte" {aBound} {rubrics} />

  <h2>What Run does</h2>
  <ol>
    <li>
      Skips the two Qualtrics rows under the header, then keeps the responses
      with <code>Finished</code> true that are not a Survey Preview.
    </li>
    <li>
      Finds the survey from its question text and shows it; correct it in the
      list if it is wrong.
    </li>
    <li>
      Joins each response's <code>Team</code> to the roster's <code>group_name</code>,
      and each roster <code>canvas_user_id</code> to the export's <code>Student Id</code>. Every student on a team gets the
      team's scores.
    </li>
    <li>
      Maps each answer to the rubric rating of the same name and its points,
      from the rubric CSV under <code>canvas/assignments/project-partner-evaluation/</code>.
      An answer
      the rubric does not name stops the run and names the answer and the
      question.
    </li>
    <li>
      Stops on a team with two finished responses and shows them side by
      side; pick the one that counts.
    </li>
    <li>
      Scores a roster team with no finished response at the lower bound of an <code>A</code>
      ({aBound} of 100): each criterion gets {aBound}% of its
      points, rated at the band that contains that value.
    </li>
    <li>
      Reports teams with no response, responses whose team matches no roster
      group, students in the export with no team (their rows are left as
      exported), and roster students missing from the export.
    </li>
  </ol>

  <h2>What to do with the downloads</h2>
  <ul>
    <li>
      <strong>Rubric assessments</strong>: import it back on the same
      assignment in the Gradebook. Spot-check one student per team before
      posting.
    </li>
    <li>
      <strong>Concerns table</strong>: every finished response that answered
      Yes to the concerns question or wrote anything in a text question, the
      responses not chosen for a team included. Instructor only: it starts the
      corroboration review and nothing in it goes to a student.
    </li>
  </ul>
</StarlightPage>
