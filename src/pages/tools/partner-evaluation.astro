---
import { getEntry } from "astro:content";
// The project partner survey generator (#440, #446) and scorer (#445). The
// rubrics, the between-anchor rule and the "What it looks like" lists, the A lower bound, and the two
// surveys' weights are read here, at build time, from the files the handbook
// renders, so the page can never carry a second copy of a rating name, a
// point value, or a weight. The components read the dropped files in the
// browser only.
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import fallCsv from "/canvas/assignments/project-partner-evaluation/partner-final-fall-rubric.csv?raw";
import springCsv from "/canvas/assignments/project-partner-evaluation/partner-final-spring-rubric.csv?raw";
import winterCsv from "/canvas/assignments/project-partner-evaluation/partner-final-winter-rubric.csv?raw";
import pulseCsv from "/canvas/assignments/project-partner-evaluation/partner-pulse-rubric.csv?raw";
import partnerMdx from "/src/content/docs/assignments/project-partner-evaluation.mdx?raw";
import gradingMdx from "/src/content/docs/learning-objectives/grading.mdx?raw";
import PartnerEvaluationScorer from "../../components/tools/PartnerEvaluationScorer.svelte";
import PartnerSurveyGenerator from "../../components/tools/PartnerSurveyGenerator.svelte";
import { canvasRows } from "../../lib/canvas-entries.mjs";
import { parseRubricCsv } from "../../lib/rubric-csv.mjs";
import { pageRules } from "../../lib/tools/partner-facets.mjs";
import { aLowerBound } from "../../lib/tools/partner-scoring.mjs";

const rubrics = {
  fall: parseRubricCsv(fallCsv, "partner-final-fall-rubric.csv"),
  pulse: parseRubricCsv(pulseCsv, "partner-pulse-rubric.csv"),
  spring: parseRubricCsv(springCsv, "partner-final-spring-rubric.csv"),
  winter: parseRubricCsv(winterCsv, "partner-final-winter-rubric.csv"),
};
const aBound = aLowerBound(gradingMdx);
// The between-anchor shares and each facet's "What it looks like" list, read
// from the partner evaluation page as aBound is from the grading page.
const rules = pageRules(partnerMdx);

// The pulse and end-of-term weights, from the partner evaluation page's
// Canvas entries, term by term, for the survey's opening page. The survey
// states one number for every term, so the terms must agree.
const PAGE = "assignments/project-partner-evaluation";
const page = await getEntry("docs", PAGE);
const rows = canvasRows(page?.data.assignment?.canvas);
const weightOf = (rubric: string) => {
  const found = new Set(
    rows
      .filter((row) => row.family.rubric.startsWith(rubric))
      .map((row) => row.weight)
  );
  const [weight] = found;
  if (found.size !== 1 || typeof weight !== "number") {
    throw new Error(`${PAGE}.mdx lists no single weight for ${rubric}.`);
  }
  return weight;
};
const weights = {
  final: weightOf("project-partner-evaluation/partner-final-"),
  pulse: weightOf("project-partner-evaluation/partner-pulse-rubric.csv"),
};
const pageUrl = new URL(`/${PAGE}/`, Astro.site).href;
---

<StarlightPage
  frontmatter={{
    description:
      "Generate the project partner surveys, and score them into a Canvas rubric-assessment CSV.",
    editUrl: false,
    head: [{ attrs: { content: "noindex", name: "robots" }, tag: "meta" }],
    pagefind: false,
    title: "Project Partner Evaluation",
  }}
>
  <p>
    Generate the Midterm Pulse or a term's End-of-Term Survey before it goes
    out, then score its export once it closes. Every file is read in your
    browser and never uploaded.
  </p>

  <h2>Generate the survey</h2>
  <p>
    The pulse's statements and labels come from the pulse rubric CSV. The
    End-of-Term Survey gives each facet of the term's rubric CSV a page: the
    facet's "What it looks like" list from the partner evaluation page, then
    one question whose choices are its anchors (or, in spring, the outcome
    ladder's rungs and a validated custom-scale entry) by their rating names,
    with a between answer at {rules.between.join("% or ")}% of the points in
    each gap. The labels are the ones the scorer maps, so the survey
    and the scorer cannot drift apart. The End-of-Term Survey sets a
    <code>Term</code> field in its Survey Flow, so its export names its term.
  </p>

  <PartnerSurveyGenerator client:only="svelte" {pageUrl} {rubrics} {rules} {weights} />

  <ol>
    <li>
      <strong>Roster with groups</strong>: in Canvas, People, Groups, export
      the group set's roster as CSV (<code>name, canvas_user_id, user_id,
      login_id, sections, group_name, canvas_group_id, group_id</code>).
      Its <code>group_name</code> becomes each partner's <code>Team</code>,
      the value the scorer joins on. Scoring reads the same file.
    </li>
    <li>
      <strong>Partner sheet</strong>: the staff sheet the team-contact letters
      read, saved as CSV.
      It reads only <code>Canvas Group Name</code> and <code>Project Partner / Mentor Email</code>;
      two addresses in a cell, or a second row for the same team, give each
      partner a row under that team, and a mentor standing in gets the survey
      like a partner.
    </li>
    <li>
      Pick the survey, the term (the current one by default; it sets the
      label in front of the survey name), and the close date: it goes into the contact list as
      <code>MidtermCloseDate</code> or <code>FinalCloseDate</code>, and the
      survey's first page shows it.
    </li>
    <li>
      In Qualtrics, Create project, Survey, From a file: import the <code>.qsf</code>.
    </li>
    <li>
      In the Directory, create a mailing list from the contact-list CSV.
      Every column maps by its header: <code>Email</code>, <code>Team</code>,
      and the close-date field. If a partner has two teams, check
      that the list kept both rows.
    </li>
    <li>
      Set the availability dates on the distribution, not in the survey, and
      distribute by email with personal links only. The survey is by
      invitation, so the anonymous link does not open it.
    </li>
  </ol>

  <h2>Score the survey</h2>
  <p>Drop the three files, check the survey, and Run.</p>

  <h3>Where the inputs come from</h3>
  <ol>
    <li>
      <strong>Roster with groups</strong>: the same file as for generating
      the survey, above.
    </li>
    <li>
      <strong>Rubric assessments</strong>: in the Gradebook, export the rubric
      assessments of the assignment this survey grades (<code>Student Id,
      Student Name</code>, then <code>Rating</code>, <code>Points</code>, and <code>Comments</code>
      per criterion). The criteria must be the ones in
      the assignment's rubric.
    </li>
    <li>
      <strong>Qualtrics responses</strong>: in Data &amp; Analysis, Export
      &amp; Import, Export Data, CSV, with "Use choice text" on. The page reads
      the labels export only and stops on a values export. The file keeps its
      three header rows.
    </li>
  </ol>

  <PartnerEvaluationScorer
    client:only="svelte"
    {aBound}
    between={rules.between}
    {rubrics}
  />

  <h3>What Run does</h3>
  <ol>
    <li>
      Skips the two Qualtrics rows under the header, then keeps the responses
      with <code>Finished</code> true that are not a Survey Preview.
    </li>
    <li>
      Finds the survey and shows it. The pulse is found by its four
      statements; an End-of-Term Survey by its <code>Term</code> field and a
      column for each facet of that term's rubric, so its term is fixed by
      <code>Term</code>: a response whose <code>Term</code> names another
      term stops the run, and one with a blank <code>Term</code> is reported
      and not scored. Pick the survey in the list only when it is not
      recognized.
    </li>
    <li>
      Joins each response's <code>Team</code> to the roster's <code>group_name</code>,
      and each roster <code>canvas_user_id</code> to the export's <code>Student Id</code>. Every student on a team gets the
      team's scores.
    </li>
    <li>
      Maps each answer to its points by the same choice list the generator
      wrote into the survey, from the rubric CSV under <code>canvas/assignments/project-partner-evaluation/</code>:
      a rating name scores its points, a between answer its share of the
      facet's points, and a ladder's custom scale the percent entered
      (stopping on a missing or out-of-range entry). The rating is the
      highest one at or below the points. An answer the survey does not offer
      stops the run and names the answer and the question.
    </li>
    <li>
      Stops on a team with two finished responses and shows them side by
      side; pick the one that counts.
    </li>
    <li>
      Scores a roster team with no finished response by <a href="/assignments/project-partner-evaluation/#if-your-partner-does-not-answer">the no-response rule</a>, the same share of every criterion.
    </li>
    <li>
      Reports teams with no response, responses whose team matches no roster
      group, students in the export with no team (their rows are left as
      exported), and roster students missing from the export.
    </li>
  </ol>

  <h3>What to do with the downloads</h3>
  <ul>
    <li>
      <strong>Rubric assessments</strong>: import it back on the same
      assignment in the Gradebook. Spot-check one student per team before
      posting.
    </li>
    <li>
      <strong>Concerns table</strong>: every finished response that answered
      Yes to the concerns question or wrote anything in a text question, the
      responses not chosen for a team included. Instructor only: it starts the
      corroboration review and nothing in it goes to a student.
    </li>
  </ul>
</StarlightPage>
