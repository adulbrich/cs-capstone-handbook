---
// Fall week 2, Workshop 1: User Story Mapping (#466). A 50-minute session:
// talk for the first 15 minutes, teams map in the template until minute 45
// with the self-check up and a volunteer clinic at about minute 30, then the
// wrap. The talk slides' target times stay at 15:00 or less in total; the
// work-time and wrap slides carry the session clock in their cues. Every
// claim on a slide traces to a URL on the sources slide. The AI demo output
// was pre-run before class and is shown as returned, split by columns over
// two slides (#478). Served at /decks/fall-week-2/.
import Notes from "../components/deck/Notes.astro";
import Slide from "../components/deck/Slide.astro";
import StoryMap from "../components/deck/StoryMap.astro";
import TitleSlide from "../components/deck/TitleSlide.astro";
import TwoColumnSlide from "../components/deck/TwoColumnSlide.astro";

export const title = "Fall Week 2: User Story Mapping";

// Shown twice, either side of the clinic, so the room keeps it in view.
const selfCheck = [
  "The backbone is what the user or the input does, never a screen or a component",
  "The walking skeleton has a story under every backbone column",
  "Every story is known, or starts with ? when it is assumed",
  "The backbone type is chosen, with one line saying why",
  "Every ? has a question on the Questions for our partner tab",
];
// The ephira map, drawn as an inherited codebase: the walking skeleton is
// what the repository already did when the advertised team started, and
// Release 1 is the advertised deliverables. Shown on its own slide and again
// after the AI tool's output.
const ephiraMap = {
  backbone: [
    "Get in safely",
    "Log a day",
    "Review the calendar",
    "See predictions",
    "Get reminders",
    "Take the data out",
  ],
  releases: [
    {
      name: "Inherited skeleton",
      stories: [
        "Password or biometric lock",
        "Full day log",
        "Calendar with a filter",
        "Last period plus 28 days",
        undefined,
        "CSV, JSON, or PDF export",
      ],
    },
    {
      name: "Release 1",
      stories: [
        undefined,
        "? Easier data entry",
        "? Clearer cycle charts",
        "Predict from history",
        "Reminders and alerts",
        "Encrypted export, import",
      ],
    },
    {
      name: "Out of scope",
      stories: [
        "Cloud sync",
        undefined,
        undefined,
        undefined,
        undefined,
        "Opt-in anonymized data collection",
      ],
    },
  ],
};
const ephiraRepo = "github.com/adulbrich/ephira";
// The advertised work the map's columns don't hold, under both copies of it.
const ephiraAlso =
  "Also advertised: tests, docs, and a store update. Pregnancy mode: start design and implementation.";
// The AI tool's ephira map, as returned (ephira's advertised project page in
// place of the prompt's placeholder). Its seven columns are split over two
// slides so the cells stay at the 32px floor. A mark is applied on the
// slide's first fragment: "had" for a story the repository already did when
// the advertised team started (planned again, or ruled out), "invented"
// for one the proposal never mentions, "misread" for a proposal line the
// tool restated wrongly as settled.
interface AiCell {
  mark?: "had" | "invented" | "misread";
  text: string;
}
interface AiColumn {
  activity: string;
  outOfScope: AiCell;
  release1: AiCell[];
  skeleton: AiCell;
}
const aiColumns: AiColumn[] = [
  {
    activity: "1. Unlock the app",
    outOfScope: { text: "Cloud accounts or login" },
    release1: [
      { mark: "had", text: "Unlock with biometrics" },
      { text: "Change passcode" },
      { text: "Auto-lock after inactivity" },
    ],
    skeleton: { mark: "had", text: "Unlock with a passcode" },
  },
  {
    activity: "2. Log a day",
    outOfScope: {
      mark: "misread",
      text: "Pregnancy tracking (design doc only)",
    },
    release1: [
      { mark: "had", text: "Log flow level" },
      { mark: "had", text: "Log symptoms and mood" },
      { mark: "had", text: "Log medications" },
      { mark: "had", text: "Edit past entries" },
    ],
    skeleton: { mark: "had", text: "Log a period start date" },
  },
  {
    activity: "3. Review history",
    outOfScope: { mark: "had", text: "Shareable doctor reports" },
    release1: [
      { text: "Color-code cycle phases" },
      { text: "Chart cycle length over time" },
      { mark: "had", text: "Filter history by symptom" },
    ],
    skeleton: { mark: "had", text: "View logged days on calendar" },
  },
  {
    activity: "4. See predictions",
    outOfScope: { text: "Machine learning predictions" },
    release1: [
      { text: "Predict from average cycle length" },
      { mark: "invented", text: "Show fertile window" },
      { text: "Flag low-confidence predictions" },
    ],
    skeleton: { mark: "had", text: "See next predicted period date" },
  },
  {
    activity: "5. Get reminders",
    outOfScope: { text: "Server-sent push notifications" },
    release1: [
      { text: "Choose reminder times" },
      { text: "Remind to log daily" },
      { text: "Alert before predicted period" },
    ],
    skeleton: { text: "Receive one local notification" },
  },
  {
    activity: "6. Back up and restore",
    outOfScope: { text: "Cloud sync" },
    release1: [
      { text: "Protect backup with passphrase" },
      { text: "Reject corrupt or wrong-key files" },
      { text: "Restore without losing existing data" },
    ],
    skeleton: { text: "Export and re-import an encrypted file" },
  },
  {
    activity: "7. Ship to stores",
    outOfScope: { text: "Opt-in anonymized data collection" },
    release1: [
      { text: "Update both store listings" },
      { text: "Run beta tester feedback round" },
      { text: "Update user and developer docs" },
    ],
    skeleton: {
      mark: "had",
      text: "Build reaches TestFlight and Play testing",
    },
  },
];
const aiSlides = [aiColumns.slice(0, 4), aiColumns.slice(4)];
const aiRows = [
  { cells: (c: AiColumn) => [c.skeleton], name: "Walking skeleton" },
  { cells: (c: AiColumn) => c.release1, name: "Release 1" },
  { cells: (c: AiColumn) => [c.outOfScope], name: "Out of scope" },
];
// Shown without its protocol, as the room would type it.
const templateUrl = new URL("/story-map-template.xlsx", Astro.site);
const template = `${templateUrl.host}${templateUrl.pathname}`;
---

<TitleSlide
  kicker="CS 461, fall week 2: Workshop 1"
  title="User Story Mapping"
  subtitle="A backbone, a release line, and a walking skeleton for your project"
  byline="CS 461: the instruction team"
>
  <Notes time="0:20" cue="Teams sit together by team number; one laptop per team opens the template.">
    <p>
      Fifteen minutes of talk, thirty minutes of mapping in teams, five
      minutes of wrap. By the end of class each team has a backbone, a
      walking-skeleton row, and its assumptions flagged.
    </p>
  </Notes>
</TitleSlide>

<Slide kicker="Four words for today" title="What a story map is made of">
  <ul>
    <li>
      <strong>Backbone:</strong> the big activities across the top, in the
      order they happen
    </li>
    <li class="fragment">
      <strong>Stories:</strong> the smaller steps under each activity, higher
      when more necessary
    </li>
    <li class="fragment">
      <strong>Release line:</strong> a cut across the map; everything above it
      ships first
    </li>
    <li class="fragment">
      <strong>Walking skeleton:</strong> the first slice, a story under every
      activity, so the whole thing runs end to end
    </li>
  </ul>
  <Notes time="1:15" cue="Press the arrow for each line; ask the room which line is the hardest to draw.">
    <p>
      Patton, whose article is on the next slide, does not prioritize the
      backbone: it is the set of things the system has to do at all. He
      prioritizes the stories hanging under it, moving them up or down, and
      lays tape across the map to make one lane per release.
    </p>
    <p>
      The stories placed highest form the smallest system that works end to
      end. Patton credits the term walking skeleton to Alistair Cockburn; use
      Patton's description here and don't paraphrase Cockburn's.
    </p>
    <p>
      One convention for today: a story nobody has checked with the project
      partner starts with a question mark, and the template turns it amber.
    </p>
  </Notes>
</Slide>

<Slide kicker="Where it comes from" title="Jeff Patton's map for Mimi">
  <ul>
    <li>Mimi: a Music Industry Marketing Interface, mapped in one day</li>
    <li class="fragment">
      The map narrowed the first release to one activity: a band member
      promoting a gig
    </li>
    <li class="fragment">
      Design the mailer, build the audience list, send it, track the
      responses
    </li>
    <li class="fragment">
      Mimi shipped; the other music features moved below the line
    </li>
  </ul>
  <Notes time="1:00" cue="One sentence on why a flat backlog loses this.">
    <p>
      From Patton's article "The New User Story Backlog is a Map". The product
      set out to do many music-industry things. Laying the whole thing out
      showed that one activity, promoting a gig, already took most of the
      map, and the rest looked like a tall order by comparison.
    </p>
    <p>
      Patton's complaint about a flat backlog is that it strips the context:
      a list in build order can't tell a stakeholder what the system does,
      and it can't show you what you missed. The map can, because you can
      walk it left to right with a user.
    </p>
  </Notes>
</Slide>

<Slide kicker="A real scope cut" title="Allegro: two years of work, six months to ship">
  <ul>
    <li>A new shipment platform, integrated with a large ERP (enterprise resource planning) system</li>
    <li class="fragment">
      Estimated at about two years; the partner's release cycle allowed six
      months
    </li>
    <li class="fragment">
      Mapped as a whole team: a minimum viable product of 120 story points,
      against a pace of about 80
    </li>
    <li class="fragment">
      Cut and thinned stories to fit, built the API on mocks first so the
      partner could start
    </li>
    <li class="fragment">Released on time, with most of the features they wanted</li>
  </ul>
  <Notes time="1:00" cue="Ask: what is your partner's equivalent of the ERP release cycle?">
    <p>
      From the second part of Allegro's engineering blog series on delivering
      products. They combined a minimum viable product, a walking skeleton, and
      story mapping. The estimate after mapping still did not fit their
      velocity, so they cut the minimum viable product further and made some
      stories thinner.
    </p>
    <p>
      The first version gave no business value on its own: an API backed by
      mocks. It let the ERP partner start integrating, which was the real
      constraint. Your partner has clocks like that too.
    </p>
  </Notes>
</Slide>

<Slide kicker="Worked example: ephira, an inherited codebase" title="Start the map from what already ships" wide>
  <StoryMap {...ephiraMap} />
  <p class="caption caption-tight">
    {ephiraAlso}<br />
    Repository: <a href={`https://${ephiraRepo}`}>{ephiraRepo}</a>
  </p>
  <Notes time="1:45" cue="Read the inherited skeleton left to right, then point at the empty reminders cell.">
    <p>
      ephira is an encrypted, local-first menstrual cycle tracker for iOS and
      Android, MIT licensed and published on both app stores. A previous
      capstone team built it. The advertised project, on the sources slide,
      asked the next team to enhance it: "This capstone project involves
      enhancing Ephira's functionality."
    </p>
    <p>
      So the inherited skeleton is what the repository
      already did the day that team started. A password or biometric lock, a
      full day log, the calendar and its filter, export as CSV, JSON, or PDF,
      and a first prediction that adds 28 days to the last period. There
      were no reminders, so the inherited skeleton has a gap, and the
      advertised notification system fills it.
    </p>
    <p>
      Release 1 is the advertised deliverables. Prediction, notifications,
      and the encrypted export and import are stated in the proposal, so
      they're known. The two amber cards are the team's reading of "UI/UX
      improvements": the proposal names data entry and cycle visualization
      but not what better means, so each is a question for the partner.
    </p>
    <p>
      Below the line on purpose: the stretch goal, opt-in anonymized data
      collection, under Take the data out because it's data leaving the
      phone; and cloud sync, under Get in safely because syncing means an
      account and a sign-in. Pregnancy mode was "start design and
      implementation", so it goes under the grid rather than in a column.
    </p>
  </Notes>
</Slide>

<TwoColumnSlide kicker="Worked example: ephira, the reveal" title="What the team added in its year" divider>
  <div slot="left">
    <h3>Added</h3>
    <ul>
      <li>A Cycle tab: predictions after two full cycles, phases, and tips</li>
      <li>Alerts before a predicted period, scheduled on the phone</li>
      <li>A guided walkthrough, and the first pregnancy mode tabs</li>
      <li>Tests, and app version 1.1.0 to 1.3.0</li>
    </ul>
  </div>
  <div slot="right">
    <h3>Not built</h3>
    <ul>
      <li>Encrypted export and import: the export is still the inherited CSV, JSON, or PDF, with no import</li>
      <li>Cloud sync and anonymized data collection: out of scope, as planned</li>
    </ul>
  </div>
  <Notes time="1:00" cue="Ask: which Release 1 card would you have checked with the partner first?">
    <p>
      From the repository history over the team's three terms. The team
      reworked prediction, added a Cycle tab with phases and wellness tips
      (the README says predictions need at least two complete cycles),
      notifications before a predicted period and for a late one, an
      onboarding walkthrough, unit tests, and pregnancy mode as its own set
      of tabs. The app's version went from 1.1.0 to 1.3.0.
    </p>
    <p>
      The proposal asked for push notifications; the team scheduled them on
      the phone instead, which keeps the product's promise that nothing
      leaves the device. The
      encrypted export and import did not land: the export screen at the
      end of the year is the inherited one, and the repository has no
      import. The commits after the team's year are the maintainer's; don't
      credit them to the team.
    </p>
  </Notes>
</TwoColumnSlide>

<Slide kicker="Three backbones, one map" title="Choose the backbone where your hardest unknowns live">
  <div class="backbones">
    <div class="type">
      <h3>User journey</h3>
      <p>What a user does, in order</p>
      <p class="skeleton">Skeleton: one user gets through every activity once</p>
    </div>
    <div class="type fragment">
      <h3>Pipeline stages</h3>
      <p>What happens to one input on its way to an output</p>
      <p class="skeleton">Skeleton: one real input reaches an output, stubs allowed</p>
    </div>
    <div class="type fragment">
      <h3>Research chain</h3>
      <p>Question, data, baseline, method, evaluation, result</p>
      <p class="skeleton">Skeleton: the baseline runs end to end and produces one number</p>
    </div>
  </div>
  <p class="fragment rule-line">
    Same rows, release line, <code>?</code> flags, and partner questions for all
    three. Write one line saying why you chose yours.
  </p>
  <Notes time="1:00" cue="Ask for hands: who is not sure their project has a user?">
    <p>
      Why it matters: the walking skeleton should exercise the riskiest part
      of the project first, so the backbone has to run through it. In a
      recent year, about half the project listings had no clean user journey
      to map, so a good part of the room needs this slide.
    </p>
    <p>
      A game is a user journey with the player as the user; a library or an
      API is a user journey with the adopting developer as the user. Pick
      the backbone where the hardest unknowns are: if the scary part is
      whether a model beats a baseline, map the research chain, even if
      there is a web front end too.
    </p>
  </Notes>
</Slide>

<Slide kicker="Pipeline backbone: the project" title="A robot glider that measures waves">
  <ul>
    <li>
      <strong>The project:</strong> fit an ocean glider, a robot that stays at
      sea for months, with a package of motion sensors that can feel the waves
    </li>
    <li class="fragment">
      <strong>Who uses the result:</strong> oceanographers, in place of wave
      buoys that are expensive, can't move, and get wrecked by storms
    </li>
    <li class="fragment">
      <strong>What goes in:</strong> the sensor's readings of how the glider
      moves
    </li>
    <li class="fragment">
      <strong>What comes out:</strong> significant wave height (how high the
      biggest waves are), worked out on board and handed to the glider to
      send to shore
    </li>
  </ul>
  <Notes time="0:45" cue="Ask: is there a user clicking through anything here?">
    <p>
      A capstone project with an oceanography lab, paired with an ECE
      (electrical and computer engineering) team that builds the sensor
      package; no one has fitted these sensors to a commercial glider yet.
      The glider moves by changing its buoyancy, not with a propeller, which
      is why it can stay out for months. Significant wave height is the
      average height of the highest third of the waves. The page also asks
      for analysis software that finds wave frequency and direction from the
      recorded readings, but only the significant wave height goes through
      the glider to shore. Nobody clicks through anything, so the backbone on
      the next slide is what happens to the readings.
    </p>
  </Notes>
</Slide>

<Slide kicker="Pipeline backbone: a sketch from the project page" title="Measuring waves from an ocean glider" wide>
  <StoryMap
    backbone={[
      "Read the sensor",
      "Correct the readings",
      "Find the wave pattern",
      "Work out wave height",
      "Hand it to the glider",
      "Reach shore",
    ]}
    releases={[
      {
        name: "Walking skeleton",
        stories: [
          "Save the raw readings",
          "A correction from a bench test",
          "Wave pattern on a laptop",
          "One height from one pattern",
          "Send one number by cable",
          "? Glider relays it to shore",
        ],
      },
      {
        name: "Release 1",
        stories: [
          "? Stay within the battery budget",
          "Remove the glider's own motion",
          ["Which way waves travel", "Charts of the pattern"],
          "Work it out on board",
          "? A message format the glider accepts",
          undefined,
        ],
      },
    ]}
  />
  <p class="caption">
    Inferred from the project page, not the team's own map. The instruction
    team found no public repository.
  </p>
  <Notes time="0:45" cue="Point at the two amber cards: they are what the page leaves open.">
    <p>
      The stages come from the project page's objectives and deliverables.
      The wave pattern is the spectrum: how much of the motion comes at each
      wave frequency, which is where height and direction come from. The
      cable is the serial link the page asks for.
    </p>
    <p>
      The amber cards are what the page leaves open: the power budget of a
      low-power system at sea, and whether the glider takes the serial
      interface. The instruction team found no public repository for this
      project.
    </p>
  </Notes>
</Slide>

<Slide kicker="Pipeline backbone: the walking skeleton" title="One thin path, sensor to shore, climbing a test ladder">
  <ol>
    <li>On a benchtop</li>
    <li class="fragment">In a ballast tank</li>
    <li class="fragment">In a wave flume with well-defined waves</li>
    <li class="fragment">In Yaquina Bay</li>
    <li class="fragment">In the open ocean near shore</li>
    <li class="fragment">In the open ocean beside a buoy with a calibrated wave sensor</li>
  </ol>
  <Notes time="0:45" cue="Ask: which rung would you be on at the end of fall?">
    <p>
      This ladder is in the project's own proposal. Read it as a walking
      skeleton: the same end-to-end path, from accelerations to one wave
      height on shore, runs at every rung, and each rung adds one kind of
      risk. A team that builds the full spectral package before the
      benchtop path works has nothing to take into the tank.
    </p>
  </Notes>
</Slide>

<Slide kicker="Research backbone: the project" title="Estimating a species' weight from its name">
  <ul>
    <li>
      <strong>The project:</strong> TaxonBodyMassML, a model that estimates
      how much a species weighs from its scientific name and its relatives
    </li>
    <li class="fragment">
      <strong>Who uses the result:</strong> ecologists, who need the weight of
      species nobody has weighed
    </li>
    <li class="fragment">
      <strong>What goes in:</strong> one species name, or a list of them
    </li>
    <li class="fragment">
      <strong>What comes out:</strong> a weight estimate, where it came from,
      and how sure the model is
    </li>
  </ul>
  <p class="deck-small after-list fragment">
    On the map: the baseline is the simplest guess worth beating, the method
    is the model, and the evaluation is how wrong it is on species kept
    aside.
  </p>
  <Notes time="0:45" cue="Ask: what would tell this team its model works?">
    <p>
      Ecologists treat body mass as a master trait: it predicts metabolism,
      lifespan, and who eats whom. Thousands of species have been weighed,
      a small share of all described species, so the project predicts the
      rest from the scientific name and the species' place in the tree of
      life. The page asks for an estimate with a provenance flag and an
      uncertainty descriptor, and a web page for single and batch queries.
    </p>
  </Notes>
</Slide>

<Slide kicker="Research backbone: a sketch from the project page" title="The weight model as a research chain" wide>
  <StoryMap
    backbone={[
      "Question",
      "Data",
      "Baseline",
      "Method",
      "Evaluation",
      "Result",
    ]}
    releases={[
      {
        name: "Walking skeleton",
        stories: [
          "Weight from a species name",
          "Measured weights, a small slice",
          "Average weight of its genus",
          "Same as the baseline for now",
          "How wrong, on species kept aside",
          "One error number",
        ],
      },
      {
        name: "Release 1",
        stories: [
          "? Relatives beat the average",
          "Learn on most, test on the rest",
          undefined,
          ["? A language model, retrained on names", "? Decision trees"],
          "Error by closeness of relatives",
          ["Estimate and how sure", "Web page for one or many names"],
        ],
      },
    ]}
  />
  <p class="caption">Inferred from the project page, not the team's own map.</p>
  <Notes time="0:45" cue="Point at the Baseline column: every method after it has a number to beat.">
    <p>
      A genus is a group of close relatives: lions and tigers share one. The
      walking skeleton never touches the clever method. It takes a slice of
      the data, predicts each species kept aside with the average weight of
      its genus, and reports one error number. The genus-average baseline is
      this deck's choice, not something the project page names.
    </p>
  </Notes>
</Slide>

<TwoColumnSlide kicker="Research backbone: what happened" title="The method changed; the chain held" divider>
  <div slot="left">
    <h3>The proposal</h3>
    <ul>
      <li>Fine-tune a large language model on name and mass pairs</li>
      <li>A web interface for single and batch queries</li>
    </ul>
  </div>
  <div slot="right">
    <h3>The repository</h3>
    <ul>
      <li>Fall: the train and test split</li>
      <li class="fragment">Winter: a gradient-boosted model on the taxonomy</li>
      <li class="fragment">That model is what shipped</li>
    </ul>
  </div>
  <Notes time="0:45" cue="Point at the Method column on the previous map: only that cell changed.">
    <p>
      The project page asked for a fine-tuned language model. The
      repository's history shows the data split in fall and an XGBoost
      regressor, a gradient-boosted tree model, in winter, and that model is
      what the team shipped. The backbone survived the change because the
      method was one column, not the whole map.
    </p>
    <p>
      The repository also shows packages and releases after the team's
      year. Those are the partner's maintenance; don't credit them to the
      team.
    </p>
  </Notes>
</TwoColumnSlide>

<Slide kicker="The other half of the room" title="Games and developer tools are user journeys too">
  <ul>
    <li>
      <strong>A game:</strong> the player launches it, learns the controls,
      plays a level, fails and retries, and finishes
    </li>
    <li class="fragment">
      <strong>A library or an API:</strong> the adopting developer finds it,
      installs it, gets a first call working, integrates it, and upgrades
    </li>
  </ul>
  <Notes time="0:30" cue="Ask a game team to name its first backbone column out loud.">
    <p>
      For a game, the walking skeleton is one level, ugly, from launch to the
      end screen. For a library, it's a first call that works from a fresh
      install, documented in the README. The developer is the user, and
      "installs it" is an activity on the map like any other.
    </p>
  </Notes>
</Slide>

<Slide kicker="AI demo: ephira's proposal" title="The same proposal, mapped by an AI tool">
  <pre class="prompt">Here is a software project proposal, as it was advertised to students:

[ADVERTISED PROJECT PROPOSAL]

Draft a user story map for the team's first release. Give a backbone of
four to seven activities in the order they happen, then a walking-skeleton
row with one story under every activity, then a Release 1 row and an
out-of-scope row. Keep each story under eight words.</pre>
  <Notes time="0:30" cue="Read the last two sentences aloud.">
    <p>
      Tool and model, named here only: Sonnet 5.5, run as a Claude Code
      sub-agent with its tools off, so it could not open the repository the
      page links. It was pre-run before class with ephira's advertised
      project page (title through preferred qualifications, contact left
      out) in place of the placeholder. The next two slides show its output
      as returned.
    </p>
    <p>
