---
// Fall week 2, Workshop 1: User Story Mapping (#466, restructured in #485,
// tightened in #510, reworked in #704). An opening (the outcome, scoring and
// reading, the agenda); user stories and story maps, on a made-up campus
// lunch app; ephira mapped by hand, then drafted twice with an AI tool;
// reference maps for a pipeline (LumiLab) and a research chain
// (TaxonBodyMassML); then the check for a team's map, the optional show by
// two volunteer teams, one slide of the five steps that stays on the screen
// while teams work, and what is due. The due slide reads the week's other
// Due items from the schedule. Every slide explains itself to someone who
// missed the session. Each link sits on the slide that uses it. Served at
// /decks/fall-week-2/.
import { Image } from "astro:assets";
import lumiLabPhoto from "../assets/decks/lumilab.webp";
import LinkedText from "../components/deck/LinkedText.astro";
import Slide from "../components/deck/Slide.astro";
import StatementSlide from "../components/deck/StatementSlide.astro";
import StoryMap from "../components/deck/StoryMap.astro";
import TitleSlide from "../components/deck/TitleSlide.astro";
import TwoColumnSlide from "../components/deck/TwoColumnSlide.astro";
import workshops from "../content/docs/assignments/workshop-activities.mdx?raw";
import schedule from "../content/docs/introduction/schedule.mdx?raw";
import { LATE } from "../lib/canvas-entries.mjs";
import { linkHrefs, plainText } from "../lib/deck-text.mjs";
import { termWeeks } from "../lib/schedule-lines.mjs";

export const title = "Fall Week 2: User Story Mapping";

// A made-up campus lunch app: the map that labels a story map's parts, row
// by row, and the one the self-check holds up against a map of screens.
const lunch = {
  backbone: ["Find food", "Order it", "Pay", "Pick it up"],
  release1: [
    "Filter by diet",
    "Save a usual order",
    "Pay with Orange Cash",
    "Text me when ready",
  ],
  release2: [undefined, undefined, undefined, "? Rate the meal"],
  skeleton: [
    "List open cafes",
    "Choose from a menu",
    "Pay by card",
    "Show a pickup code",
  ],
};

// What a team hands in, as the workshop page states fall Workshop 1's
// complete submission, split into its four parts: the opening slide
// promises them, the scoring slide sums them up, and the due slide lists
// them. The build fails when the line no longer reads as those parts.
const SUBMISSION = "- **A complete submission:** ";
const fallWorkshops = workshops.slice(
  workshops.indexOf("\n## Fall"),
  workshops.indexOf("\n## Winter")
);
const submissionLine = fallWorkshops
  .split("\n### Workshop 1:")[1]
  ?.split("\n")
  .find((text) => text.startsWith(SUBMISSION));
const SUBMISSION_PARTS_RE =
  /^(a user story map of .+? walking-skeleton row), (its backbone type and the reason for it), (written user stories each marked in or out of scope for this year), and (the list of questions for your project partner, .+)$/;
const submissionParts = submissionLine
  ? plainText(submissionLine.slice(SUBMISSION.length)).match(
      SUBMISSION_PARTS_RE
    )
  : null;
if (!submissionParts) {
  throw new Error(
    "fall-week-2: the workshop page's fall Workshop 1 complete submission no longer reads as a map, its backbone type, marked stories, and partner questions."
  );
}
// Each part as a list item, its first letter capitalized and each ? set as
// code the way the template writes it.
const handInItems = submissionParts
  .slice(1)
  .map(
    (part) =>
      `<li>${part.charAt(0).toUpperCase()}${part.slice(1).replaceAll("`?`", "<code>?</code>")}</li>`
  )
  .join("");

// Each example's links. The slides are shared with the class, so a slide
// shows a link by its page's name, never its URL.
const ephira = {
  page: "https://capstone.eecs.oregonstate.edu/projects/32032898-6457-5a14-b451-2f1c1a97501a",
  repo: "https://github.com/adulbrich/ephira",
};
const lumiLab = {
  page: "https://capstone.eecs.oregonstate.edu/projects/4e8e30be-72ac-5203-83fd-f4515162ce75",
  repo: "https://github.com/radiantlab/LumiLab",
};
const taxon = {
  page: "https://capstone.eecs.oregonstate.edu/projects/1e6e1a34-dee3-54bf-8c53-f876fb2d1519",
  repo: "https://github.com/TaxonBodyMassML/TaxonBodyMassML",
};
const patton = "https://jpattonassociates.com/the-new-backlog/";
const nngroup = "https://www.nngroup.com/articles/user-story-mapping/";
// The tutorial the LumiLab map's columns come from.
const pierson = "https://doi.org/10.1080/15502724.2019.1684319";

// The ephira map, drawn as an inherited codebase: the walking skeleton is
// what the repository already did when the advertised team started, and
// Release 1 is the advertised deliverables. The stretch goal keeps its own
// row, as the proposal labels it.
const ephiraMap = {
  backbone: [
    "Get in safely",
    "Log a day",
    "Review the calendar",
    "See predictions",
    "Get reminders",
    "Take the data out",
  ],
  releases: [
    {
      name: "Inherited skeleton",
      stories: [
        "Password or biometric lock",
        "Full day log",
        "Calendar with a filter",
        "28-day guess, not working",
        undefined,
        "CSV, JSON, or PDF export",
      ],
    },
    {
      name: "Release 1",
      stories: [
        undefined,
        "? Easier data entry",
        "? Clearer cycle charts",
        "Predict from history",
        ["? Period alerts", "Log reminders"],
        "? Encrypted export, import",
      ],
    },
    {
      name: "Stretch goal",
      stories: [
        undefined,
        undefined,
        undefined,
        undefined,
        undefined,
        "Anonymized data, opt-in",
      ],
    },
    {
      name: "Out of scope this year",
      stories: ["Cloud sync"],
    },
  ],
};

// Handbook links, each shown by its page's name.
const handbook = (path: string) => new URL(path, Astro.site).href;
const template = handbook("/story-map-template.xlsx");
const activity = handbook("/activities/requirements/#user-story-mapping");
const guide = handbook("/guides/requirements/#story-mapping");

// Who hands it in, as the workshop page states it for every workshop.
const PER_TEAM = "One PDF per team per workshop";
if (!workshops.includes(PER_TEAM)) {
  throw new Error(
    `fall-week-2: the workshop page no longer says "${PER_TEAM}".`
  );
}

// Due this week besides the workshop submission the due slide spells out,
// read from the fall schedule's week 2 Due line. The build fails when that
// line no longer lists the workshop, so the slide never shows a list read
// from the wrong line or from none.
const WEEK = 2;
const WORKSHOPS_PAGE = "/assignments/workshop-activities/";
const isWorkshop = (item: string) =>
  linkHrefs(item).some((href) => href.startsWith(WORKSHOPS_PAGE));
const dueItems =
  termWeeks(schedule, "fall")
    .find(({ week }) => week === WEEK)
    ?.rows.get("Due")?.items ?? [];
if (!dueItems.some(isWorkshop)) {
  throw new Error(
    `fall-week-2: the fall schedule's week ${WEEK} Due line doesn't list the workshop.`
  );
}
const alsoDue = dueItems.filter((item) => !isWorkshop(item));
---

<TitleSlide
  kicker="CS 461, fall week 2: Workshop 1"
  title="User Story Mapping"
  subtitle="A backbone, a walking skeleton, and release rows for your project"
  byline="Alex Ulbrich and Kirsten Winters"
/>

<Slide kicker="Today's outcome" title="By the end of the session, your team has a first map">
  <ul set:html={handInItems} />
  <p class="deck-small after-list">
    Why it matters: you turn the map into <code>docs/requirements.md</code> at
    Repo Checkpoint 1, and its <code>?</code> cards are the agenda for your first
    partner meeting.
  </p>
</Slide>

<Slide kicker="Workshop 1" title="Graded complete or incomplete">
  <ul>
    <li>
      Complete when it holds your map, its backbone type and why, every story
      marked in or out of scope, and a question for every <code>?</code>:
      there is no quality bar
    </li>
    <li>{LATE["class-week"].text}</li>
    <li>
      A submission that is not about your own project or team, such as a
      generic output produced without your team's material, scores Incomplete
    </li>
  </ul>
  <p class="caption">
    Read for this session:<br />
    <a href={guide}>Requirements: Story Mapping</a><br />
    <a href={nngroup}>Nielsen Norman Group: User Story Mapping</a>
  </p>
</Slide>

<Slide kicker="Workshop 1" title="Agenda">
  <ul>
    <li>User stories and story maps</li>
    <li>Example: ephira, a period tracker, mapped by hand, then drafted with AI</li>
    <li>Reference maps for a pipeline (LumiLab) and a research chain (TaxonBodyMassML)</li>
        <li>Check a map: steps people take, not screens</li>
    <li>Optional: two teams show their top row</li>
    <li>Your team's first map, in five steps</li>
  </ul>
</Slide>

<Slide kicker="User stories and story maps" title="A user story is one thing a person can do">
  <p class="story-def">
    Small enough to finish in one sprint (two weeks), and written so anyone
    can check it works
  </p>
  <div class="story-shape fragment">
    <div class="story-part">
      <p class="slot">As a <span class="blank">who</span></p>
      <p class="fill">someone tracking their cycle,</p>
    </div>
    <div class="story-part">
      <p class="slot">I want <span class="blank">what</span></p>
      <p class="fill">my next period predicted from my own history,</p>
    </div>
    <div class="story-part">
      <p class="slot">so that <span class="blank">why</span></p>
      <p class="fill">I can plan around it</p>
    </div>
  </div>
  <div class="story-card fragment">
    <span class="card-arrow" aria-hidden="true"></span>
    <span class="map-card">Predict from history</span>
    <p>On a story map, the card holds only the short version</p>
  </div>
</Slide>

<Slide kicker="User stories and story maps" title="What a story map is made of" wide>
  <StoryMap
    backbone={lunch.backbone}
    releases={[
      { name: "Walking skeleton", stories: lunch.skeleton },
      { name: "Release 1", stories: lunch.release1 },
      { name: "Release 2", stories: lunch.release2 },
    ]}
    callouts={[
      { at: "backbone", term: "Backbone: the top row", text: "what people do, in order" },
      { at: "row", row: 0, term: "Walking skeleton", text: "built in the fall: one thin path through every column" },
      { at: "line", row: 1, term: "Release 1", text: "the first iteration after the skeleton" },
      { at: "card", row: 2, column: 3, term: "A ? card", text: "a guess nobody has checked with the partner yet" },
    ]}
    legend={false}
    stepped
  />
  <p class="caption caption-tight">
        A made-up campus lunch app. Add release rows as you need, then end with
    Out of scope this year: a card in a release row is in, and one in Out of
    scope this year is out. Jeff Patton, <a href={patton}>The New User Story Backlog is a Map</a>
  </p>
</Slide>

<Slide kicker="User stories and story maps" title="Choose the backbone type that holds your hardest unknowns" wide>
  <div class="backbones">
    <div class="type">
      <h3>User journey</h3>
      <p>What a user does, in order</p>
      <p class="skeleton">Skeleton: one user gets through every activity once</p>
    </div>
    <div class="type fragment">
      <h3>Pipeline stages</h3>
      <p>What happens to one input on its way to an output</p>
      <p class="skeleton">Skeleton: one real input reaches an output, stubs allowed</p>
      <p class="skeleton">Reference map: LumiLab</p>
    </div>
    <div class="type fragment">
      <h3>Research chain</h3>
      <p>Question, data, baseline, method, evaluation, result</p>
      <p class="skeleton">Skeleton: the baseline runs end to end and produces one number</p>
      <p class="skeleton">Reference map: TaxonBodyMassML</p>
    </div>
  </div>
  <p class="fragment rule-line">
    Same rows and <code>?</code> flags for all three. Write one line saying
    why you chose yours.
  </p>
  <p class="caption fragment">
    On a pipeline or research map, a card is one piece of work instead of a
    user story: one stage, one experiment.
  </p>
</Slide>

<Slide kicker="User stories and story maps" title="More than one kind of user? Still one map" wide>
  <StoryMap
    backbone={["Find food", "Order it", "Pay", "Kitchen cooks", "Pick it up"]}
    releases={[
      {
        name: "Walking skeleton",
        stories: [
          "List open cafes",
          "Choose from a menu",
          "Pay by card",
          "See new orders on a screen",
          "Show a pickup code",
        ],
      },
    ]}
    users={{
      primary: "Student, the primary user",
      other: "Kitchen staff: a column only where their path diverges",
      columns: [3],
    }}
    legend={false}
  />
  <p class="caption">
    One map for the whole project, not one per persona: the student orders and
    picks up, and the kitchen staff cook the order in between.
  </p>
</Slide>

<StatementSlide kicker="Example: ephira, a user journey">
  One proposal, mapped by hand, then drafted twice with AI
</StatementSlide>

<Slide kicker="Example: ephira, a user journey" title="A private period tracker, already in both app stores">
  <ul>
    <li>
      <strong>The app:</strong> a menstrual cycle tracker for iOS and Android
      that keeps every record on the phone
    </li>
    <li class="fragment">
      <strong>Where it started:</strong> a previous capstone team built it and
      published it in both app stores
    </li>
    <li class="fragment">
      <strong>The advertised project:</strong> enhance it, with predictions,
            reminders, encrypted backups, easier data entry, tests, a store update,
      and a start on pregnancy mode
    </li>
  </ul>
  <p class="caption">
    Repository: <a href={ephira.repo}>ephira on GitHub</a><br />
    Project page: <a href={ephira.page}>Ephira (iOS/Android)</a>
  </p>
</Slide>

<Slide kicker="Example: ephira, mapped by hand" title="ephira: start the map from what already ships" wide>
  <StoryMap {...ephiraMap} legend={false} />
</Slide>

<TwoColumnSlide kicker="Example: ephira, what happened" title="What the team built in its year" divider wide>
  <div slot="left">
    <h3>Added</h3>
    <ul class="reveal-list">
      <li>Faster logging: a chip grid and one-tap birth control</li>
      <li>A Cycle tab: predictions from average cycle length, phases, and tips</li>
      <li>Alerts before a predicted period, scheduled on the phone</li>
      <li>A guided walkthrough, and the first pregnancy mode tabs</li>
      <li>Unit tests, and app version 1.1.0 to 1.3.0</li>
    </ul>
  </div>
  <div slot="right">
    <h3>Not built</h3>
    <ul class="reveal-list">
      <li>Encrypted export and import: the export is still the inherited one, with no import</li>
      <li>Reminders to log a day: a message template, never scheduled</li>
      <li>Integration and end-to-end tests: unit tests only</li>
      <li>Cloud sync and the stretch goal: not attempted</li>
    </ul>
  </div>
  <p class="caption">
    From the repository's history over the team's year:
    <a href={ephira.repo}>ephira on GitHub</a>
  </p>
</TwoColumnSlide>

<Slide kicker="Example: ephira, drafted with AI" title="One prompt, run twice" wide>
  <pre class="prompt">Here is a software project proposal, as it was advertised to students:

[ephira's project page, as advertised]

<span class="prompt-added">The project's repository, as it was the day the team started, is at
[path]. Read it before drafting.</span>

Draft a user story map for the team's first release. Give a backbone of
four to seven activities in the order they happen, then a walking-skeleton
row with one story under every activity, then a Release 1 row and an
out-of-scope row. Keep each story under eight words.</pre>
  <p class="caption">
    Run 1: the prompt without the highlighted lines. Run 2: the whole prompt,
    with the repository to read.<br />
    Project page: <a href={ephira.page}>Ephira (iOS/Android)</a>
  </p>
</Slide>

<TwoColumnSlide kicker="ephira: the two AI drafts" title="With the repository, the draft starts from what the app does" divider>
  <div slot="left">
    <h3>Proposal only</h3>
    <ul class="reveal-list">
      <li>Planned the lock, the day log, and the calendar the app already had</li>
      <li>Added a fertile window the proposal never asks for</li>
      <li>Cut pregnancy mode, which the proposal asks for, to a design document, stated as settled</li>
    </ul>
  </div>
  <div slot="right">
    <h3>Proposal and repository</h3>
    <ul class="reveal-list">
      <li class="fragment">Found the 28-day guess and planned a prediction from average cycle length</li>
      <li class="fragment">Found no reminders and no import, and planned both</li>
      <li class="fragment">Found encryption set up with no key: a question the hand-drawn map missed</li>
      <li class="fragment">Still cut pregnancy mode to a design draft, with no <code>?</code> on any card</li>
    </ul>
  </div>
</TwoColumnSlide>

<TwoColumnSlide kicker="Drafting a map with an AI tool" title="Give it all your context, then make it flag its guesses" divider>
  <div slot="left">
    <h3>Give it</h3>
    <ul>
      <li>The project description</li>
      <li>The repository, if you inherit one: let the tool read the code</li>
      <li>Papers your partner cites, earlier teams' documents, your partner meeting notes</li>
    </ul>
  </div>
  <div slot="right">
    <h3>Then</h3>
    <ul>
      <li class="fragment">Ask for the map in the story map template's rows</li>
      <li class="fragment">
        Ask it to start with <code>?</code> every card it can't trace to what
        you gave it
      </li>
      <li class="fragment">Check each card against the code, then with your partner</li>
    </ul>
  </div>
  <p class="caption fragment">
    Give it only what your Team Charter's AI and Confidentiality section
    allows.
  </p>
</TwoColumnSlide>

<StatementSlide source="LumiLab, a pipeline; TaxonBodyMassML, a research chain">
  Reference maps for the other two backbone types
</StatementSlide>

<Slide kicker="Reference map: LumiLab, a pipeline" title="Measuring glare from ordinary photos">
  <div class="with-photo">
    <ul>
      <li>
        <strong>Glare:</strong> light bright enough to make seeing
        uncomfortable. Measuring it takes a luminance camera, which few can
        afford
      </li>
      <li class="fragment">
        <strong>What goes in:</strong> the same scene photographed several
        times, dark to bright, with an ordinary camera, plus that camera's
        calibration files
      </li>
      <li class="fragment">
        <strong>What comes out:</strong> a luminance map, an image where every
        pixel holds how bright that spot was, in measured units
      </li>
      <li class="fragment">
        <strong>Who uses it:</strong> lighting designers and daylighting
        researchers
      </li>
    </ul>
    <Image
      src={lumiLabPhoto}
      alt="Two fisheye photos of office desks by a window, each beside its luminance map in false color, with the windows in yellow"
      width={400}
    />
  </div>
  <p class="caption">
    Repository: <a href={lumiLab.repo}>LumiLab on GitHub</a><br />
    Project page: <a href={lumiLab.page}>Architectural Lighting Design: Image Processing and Analysis Software</a>
  </p>
</Slide>

<Slide kicker="Reference map: LumiLab" title="Photos to a luminance map: a script, then an app" wide>
  <StoryMap
    backbone={[
      "Select exposures",
      "Merge into one image",
      "Crop and resize",
      "Correct the lens",
      "Scale to the meter",
      "Record view angles",
      "Check with a meter",
    ]}
    releases={[
      {
        name: "Walking skeleton",
        goal: "one script, one photo set",
        stories: [
          "Keep frames by pixel count",
          ["Merge with a tool", "Reset exposure"],
          "Crop to the lens, shrink",
          "Built-in lens files",
          "One fixed scale factor",
          "Fixed viewing angles",
          "Compare with the meter",
        ],
      },
      {
        name: "Release 1",
        goal: "the app over the script",
        stories: [
          "Pick photos or a folder",
          "Upload calibration",
          "Type crop and size numbers",
          "Upload lens files",
          "? Type a meter reading",
          "Type the viewing angles",
          "Run all, view the map",
        ],
      },
    ]}
    legend={false}
  />
  <p class="caption caption-tight">
    Simplified from Table 3 of Pierson, Cauwerts, Bodart, and Wienold, <a href={pierson}>"Tutorial:
    Luminance Maps for Daylighting Studies from High Dynamic Range
    Photography"</a>
  </p>
</Slide>

<Slide kicker="Reference map: TaxonBodyMassML, a research chain" title="Estimating a species' weight from its name">
  <ul>
    <li>
      <strong>The project:</strong> a model that estimates how much a species
      weighs from its scientific name and its relatives
    </li>
    <li class="fragment">
      <strong>Who uses the result:</strong> ecologists, who need the weight of
      species nobody has weighed
    </li>
    <li class="fragment">
      <strong>What goes in:</strong> one species name, or a list of them
    </li>
    <li class="fragment">
      <strong>What comes out:</strong> a weight estimate, where it came from,
      and how sure the model is
    </li>
  </ul>
  <p class="caption">
    Repository: <a href={taxon.repo}>TaxonBodyMassML on GitHub</a><br />
    Project page: <a href={taxon.page}>TaxonBodyMassML: Phylogeny-informed prediction of species body weight</a>
  </p>
</Slide>

<Slide kicker="Reference map: TaxonBodyMassML" title="The weight model as a research chain" wide>
  <StoryMap
    backbone={[
      "Question",
      "Data",
      "Baseline",
      "Method",
      "Evaluation",
      "Result",
    ]}
    releases={[
      {
        name: "Walking skeleton",
        goal: "as it should run in the fall",
        stories: [
          "Mass from a name, 95 of 100 within 10x",
          "Measured masses, 90/10 split",
          "A simple model to beat",
          "Same as the baseline for now",
          "Error on the held-out tenth",
          "One estimate per name",
        ],
      },
      {
        name: "Release 1",
        goal: "built in winter and spring",
        stories: [
          undefined,
          ["Full taxonomy, GBIF and NCBI", "Masses in log10"],
          undefined,
          "Boosted trees on the taxonomy",
          "RMSE and R² in log10",
          ["Measured mass, or an estimate with a 90% interval", "Two web services"],
        ],
      },
    ]}
    legend={false}
  />
  <p class="caption caption-tight">
    Release 1 comes from the team's repository. Its Baseline cell is empty:
    the team never built one.
  </p>
</Slide>

<Slide kicker="Before you submit" title="Check your map: steps people take, not screens" wide>
  <p class="verdict verdict-yes">Like this</p>
  <StoryMap
    backbone={lunch.backbone}
    releases={[
      {
        name: "Walking skeleton",
        stories: [lunch.skeleton[0], lunch.skeleton[1], "? Pay with Orange Cash", lunch.skeleton[3]],
      },
    ]}
    callouts={[
      { at: "backbone", term: "What people do, in order" },
      { at: "row", row: 0, term: "A card in every column; a ? on each guess" },
    ]}
    legend={false}
  />
  <p class="verdict verdict-no">Not like this</p>
  <StoryMap
    backbone={["Home page", "Menu page", "Database", "Payment API"]}
    releases={[
      {
        name: "Walking skeleton",
        stories: ["Log in", "Show menu", undefined, "Charge card"],
      },
    ]}
    callouts={[
      { at: "backbone", term: "Screens and parts of the code" },
      { at: "row", row: 0, term: "A gap: not end to end" },
    ]}
  />
  <p class="caption caption-tight">
    Also check: one line on why this backbone type, and a question on the
    second tab for every <code>?</code>. A gap in the skeleton? Fill it
    before Release 1, however unsure the card.
  </p>
</Slide>

<Slide kicker="Optional" title="Two volunteer teams show their top row">
  <ol class="steps" style="--steps: 3;">
    <li>
      <p>A team volunteers and puts its map on the big screen</p>
    </li>
    <li>
      <p>It reads its top row aloud, left to right, as one story</p>
    </li>
    <li>
      <p>Two minutes of feedback from the room: one thing that works, one thing to change</p>
    </li>
  </ol>
  <p class="rule-line">
    If your partner asked you to keep the project confidential (an NDA), don't
    volunteer.
  </p>
</Slide>

<Slide kicker="Work time" title="Your turn: five steps as a team" wide>
  <ol class="steps" style="--steps: 5;">
