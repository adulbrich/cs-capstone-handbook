---
// Fall week 2, Workshop 1: User Story Mapping (#466, restructured in #485).
// A 50-minute session in four parts, named with their minute marks on the
// agenda slide: user stories and story maps (minute 1), three worked
// examples (minute 4), the same proposal mapped by an AI tool (minute 11),
// and the teams' own maps (minute 15), with two volunteer teams showing
// their maps at minute 30 and the wrap at minute 45. The slides students
// act on (Part 4) explain themselves to someone who missed the talk. The talk slides' target times sum to 15:00, and each part's
// start on the agenda is the running total of the notes before it. Each
// link sits on the slide that uses it. The AI demo output was pre-run
// before class; the side-by-side slide shortens it, and its notes hold it
// in full. Served at /decks/fall-week-2/.
import Notes from "../components/deck/Notes.astro";
import Slide from "../components/deck/Slide.astro";
import StatementSlide from "../components/deck/StatementSlide.astro";
import StoryMap from "../components/deck/StoryMap.astro";
import TitleSlide from "../components/deck/TitleSlide.astro";
import TwoColumnSlide from "../components/deck/TwoColumnSlide.astro";

export const title = "Fall Week 2: User Story Mapping";

// A made-up campus lunch app, the one map Part 1 labels part by part and
// Part 4's self-check holds up against a map of screens.
const lunch = {
  backbone: ["Find food", "Order it", "Pay", "Pick it up"],
  skeleton: [
    "List open cafes",
    "Choose from a menu",
    "Pay by card",
    "Show a pickup code",
  ],
};

// Each example's links, shown without the protocol, as the room would type
// them.
const PROTOCOL = /^https:\/\//;
const link = (url: string) => ({ href: url, text: url.replace(PROTOCOL, "") });
const ephira = {
  page: link(
    "https://capstone.eecs.oregonstate.edu/projects/32032898-6457-5a14-b451-2f1c1a97501a"
  ),
  repo: link("https://github.com/adulbrich/ephira"),
};
const lumiLab = {
  page: link(
    "https://capstone.eecs.oregonstate.edu/projects/4e8e30be-72ac-5203-83fd-f4515162ce75"
  ),
  repo: link("https://github.com/radiantlab/LumiLab"),
};
const taxon = {
  page: link(
    "https://capstone.eecs.oregonstate.edu/projects/1e6e1a34-dee3-54bf-8c53-f876fb2d1519"
  ),
  repo: link("https://github.com/TaxonBodyMassML/TaxonBodyMassML"),
};
const patton = link("https://jpattonassociates.com/the-new-backlog/");

// The ephira map, drawn as an inherited codebase: the walking skeleton is
// what the repository already did when the advertised team started, and
// Release 1 is the advertised deliverables. The stretch goal keeps its own
// row, as the proposal labels it.
const ephiraMap = {
  backbone: [
    "Get in safely",
    "Log a day",
    "Review the calendar",
    "See predictions",
    "Get reminders",
    "Take the data out",
  ],
  releases: [
    {
      name: "Inherited skeleton",
      stories: [
        "Password or biometric lock",
        "Full day log",
        "Calendar with a filter",
        "28-day guess, not working",
        undefined,
        "CSV, JSON, or PDF export",
      ],
    },
    {
      name: "Release 1",
      stories: [
        undefined,
        "? Easier data entry",
        "? Clearer cycle charts",
        "Predict from history",
        ["? Period alerts", "Log reminders"],
        "? Encrypted export, import",
      ],
    },
    {
      name: "Stretch goal",
      stories: [
        undefined,
        undefined,
        undefined,
        undefined,
        undefined,
        "Anonymized data, opt-in",
      ],
    },
    {
      name: "Out of scope",
      stories: ["Cloud sync"],
    },
  ],
};

// The side-by-side of the human map above and the AI tool's map, one row per
// activity, each row with one mark. The Human cells follow the map as the
// room saw it; "Had:" is the inherited skeleton.
type Mark = "agree" | "drops" | "invents" | "misreads" | "replans";
const marks: Record<Mark, { label: string; means: string }> = {
  agree: { label: "Agree", means: "both plan the work" },
  drops: { label: "Human drops", means: "a deliverable off the grid" },
  invents: { label: "AI invents", means: "not in the proposal" },
  misreads: { label: "AI misreads", means: "misstates the proposal" },
  replans: { label: "AI re-plans", means: "already in the app" },
};
const comparison: {
  activity: string;
  ai: string;
  human: string;
  mark: Mark;
}[] = [
  {
    activity: "Unlock",
    ai: "Passcode, then biometrics, auto-lock",
    human: "Had: lock. Release 1: nothing",
    mark: "replans",
  },
  {
    activity: "Log a day",
    ai: "Period start, then symptoms, edits",
    human: "Had: full log. ? Easier entry",
    mark: "replans",
  },
  {
    activity: "Calendar",
    ai: "Calendar, then phase colors, charts",
    human: "Had: filter. ? Clearer charts",
    mark: "replans",
  },
  {
    activity: "Predictions",
    ai: "Next date, averages, fertile window",
    human: "Had: broken guess. Predict from history",
    mark: "invents",
  },
  {
    activity: "Reminders",
    ai: "One alert, then times, daily nudge",
    human: "? Period alerts. Log reminders",
    mark: "agree",
  },
  {
    activity: "Data out",
    ai: "Encrypted backup, restore, passphrase",
    human: "Had: export. ? Encrypted export, import",
    mark: "agree",
  },
  {
    activity: "Stores",
    ai: "TestFlight first, then listings, beta",
    human: "No column: a caption line",
    mark: "drops",
  },
  {
    activity: "Pregnancy",
    ai: "Out of scope: design doc only",
    human: "Caption: start design and build",
    mark: "misreads",
  },
];
// The legend's order: the AI tool's mistakes, the human map's, agreement.
const legend: Mark[] = ["replans", "invents", "misreads", "drops", "agree"];
// Draws each "?" in a cell as the amber assumed mark.
const QUESTION = /(\?)/;
const flagged = (text: string) => text.split(QUESTION);

// The AI tool's ephira map as returned, for the side-by-side slide's notes.
const aiOutput = [
  {
    activity: "1. Unlock the app",
    outOfScope: "Cloud accounts or login",
    release1: [
      "Unlock with biometrics",
      "Change passcode",
      "Auto-lock after inactivity",
    ],
    skeleton: "Unlock with a passcode",
  },
  {
    activity: "2. Log a day",
    outOfScope: "Pregnancy tracking (design doc only)",
    release1: [
      "Log flow level",
      "Log symptoms and mood",
      "Log medications",
      "Edit past entries",
    ],
    skeleton: "Log a period start date",
  },
  {
    activity: "3. Review history",
    outOfScope: "Shareable doctor reports",
    release1: [
      "Color-code cycle phases",
      "Chart cycle length over time",
      "Filter history by symptom",
    ],
    skeleton: "View logged days on calendar",
  },
  {
    activity: "4. See predictions",
    outOfScope: "Machine learning predictions",
    release1: [
      "Predict from average cycle length",
      "Show fertile window",
      "Flag low-confidence predictions",
    ],
    skeleton: "See next predicted period date",
  },
  {
    activity: "5. Get reminders",
    outOfScope: "Server-sent push notifications",
    release1: [
      "Choose reminder times",
      "Remind to log daily",
      "Alert before predicted period",
    ],
    skeleton: "Receive one local notification",
  },
  {
    activity: "6. Back up and restore",
    outOfScope: "Cloud sync",
    release1: [
      "Protect backup with passphrase",
      "Reject corrupt or wrong-key files",
      "Restore without losing existing data",
    ],
    skeleton: "Export and re-import an encrypted file",
  },
  {
    activity: "7. Ship to stores",
    outOfScope: "Opt-in anonymized data collection",
    release1: [
      "Update both store listings",
      "Run beta tester feedback round",
      "Update user and developer docs",
    ],
    skeleton: "Build reaches TestFlight and Play testing",
  },
];

// Shown without its protocol, as the room would type it.
const templateUrl = new URL("/story-map-template.xlsx", Astro.site);
const template = `${templateUrl.host}${templateUrl.pathname}`;
---

<TitleSlide
  kicker="CS 461, fall week 2: Workshop 1"
  title="User Story Mapping"
  subtitle="A backbone, a release line, and a walking skeleton for your project"
  byline="CS 461: the instruction team"
>
  <Notes time="0:20" cue="Teams sit together by team number; one laptop per team opens the template.">
    <p>
      By the end of class each team has a backbone, a walking-skeleton row,
      and its assumptions flagged. The next slide is the plan for the hour.
    </p>
  </Notes>
</TitleSlide>

<Slide kicker="Agenda" title="Today, in four parts">
  <ol class="agenda">
    <li><span class="minute">Minute 1</span>User stories and story maps</li>
    <li><span class="minute">Minute 4</span>Three examples: ephira, LumiLab, TaxonBodyMassML</li>
    <li><span class="minute">Minute 11</span>The same proposal, mapped by AI</li>
    <li>
      <span class="minute">Minute 15</span>Your turn: map in teams; two teams
      show their maps at minute 30; the wrap at minute 45
    </li>
  </ol>
  <Notes time="0:40" cue="Point at minute 15: that is when the laptops open.">
    <p>
      Fifteen minutes of talk, thirty of mapping, five of wrap. The three
      examples use three different backbones, so every team should see one
      that looks like its own project. The AI part maps one of those
      examples again, with a tool, so the room can compare the two maps row
      by row.
    </p>
  </Notes>
</Slide>

<Slide kicker="Part 1: user stories and story maps" title="A user story is one thing a person can do">
  <p class="story-def">
    Small enough to finish in one sprint (two weeks), and written so anyone
    can check it works
  </p>
  <div class="story-shape fragment">
    <div class="story-part">
      <p class="slot">As a <span class="blank">who</span></p>
      <p class="fill">someone tracking their cycle,</p>
    </div>
    <div class="story-part">
      <p class="slot">I want <span class="blank">what</span></p>
      <p class="fill">my next period predicted from my own history,</p>
    </div>
    <div class="story-part">
      <p class="slot">so that <span class="blank">why</span></p>
      <p class="fill">I can plan around it</p>
    </div>
  </div>
  <div class="story-card fragment">
    <span class="card-arrow" aria-hidden="true"></span>
    <span class="map-card">Predict from history</span>
    <p>On a story map, the card holds only the short version</p>
  </div>
  <p class="caption fragment">
    On a pipeline or research map, a card is one piece of work instead: one
    stage, one experiment.
  </p>
  <Notes time="1:00" cue="Press the arrow three times: the sentence, the card, the pipeline line.">
    <p>
      A user story states one requirement from the user's side. The example
      is a real card from the ephira map coming up in example 1, written out
      in the common sentence shape: who, what, and why. The "so that" part is
      where the reason gets written down, and it's the part teams skip.
    </p>
    <p>
      Mike Cohn's point, from the requirements guide: the written story is a
      reminder to have a conversation with the partner, not the whole
      requirement. The map only needs the short card. A team with no user,
      a pipeline or a research project, writes cards the same size: one
      stage, one experiment.
    </p>
  </Notes>
</Slide>

<Slide kicker="Part 1: user stories and story maps" title="What a story map is made of" wide>
  <StoryMap
    backbone={lunch.backbone}
    releases={[
      { name: "Walking skeleton", stories: lunch.skeleton },
      {
        name: "Release 1",
        stories: [
          "Filter by diet",
          "Save a usual order",
          "Pay with dining dollars",
          ["Choose a pickup time", "Text me when ready"],
        ],
      },
    ]}
    callouts={[
      { at: "backbone", term: "Backbone: the top row", text: "what people do, in order" },
      { at: "row", row: 0, term: "Walking skeleton", text: "the first row: one thin path through every column" },
      { at: "line", row: 1, term: "Release line", text: "everything above it ships first" },
      { at: "card", row: 1, column: 3, item: 1, term: "A card", text: "one story, in a few words" },
    ]}
    stepped
  />
  <p class="caption caption-tight">
    A made-up campus lunch app. Jeff Patton, The New User Story Backlog is a
    Map: <a href={patton.href}>{patton.text}</a>
  </p>
  <Notes time="1:00" cue="Press the arrow for each label, top to bottom.">
    <p>
      Jeff Patton's article, linked on the slide, is where the map comes
      from. The backbone is everything the system has to do at all, so it
      isn't prioritized; the cards under it are, higher when more necessary.
      The walking skeleton is the smallest system that works end to end,
      however thin each card is.
    </p>
    <p>
      His complaint about a flat backlog: a list in build order can't tell
      anyone what the system does, or show what's missing. A map can, because
      you can walk it left to right with a user. One convention for today: a
      card nobody has checked with the partner starts with a question mark.
    </p>
  </Notes>
</Slide>

<Slide kicker="Part 1: user stories and story maps" title="Choose the backbone where your hardest unknowns live">
  <div class="backbones">
    <div class="type">
      <h3>User journey</h3>
      <p>What a user does, in order</p>
      <p class="skeleton">Skeleton: one user gets through every activity once</p>
    </div>
    <div class="type fragment">
      <h3>Pipeline stages</h3>
      <p>What happens to one input on its way to an output</p>
      <p class="skeleton">Skeleton: one real input reaches an output, stubs allowed</p>
    </div>
    <div class="type fragment">
      <h3>Research chain</h3>
      <p>Question, data, baseline, method, evaluation, result</p>
      <p class="skeleton">Skeleton: the baseline runs end to end and produces one number</p>
    </div>
  </div>
  <p class="fragment rule-line">
    Same rows, release line, <code>?</code> flags, and partner questions for all
    three. Write one line saying why you chose yours.
  </p>
  <Notes time="1:00" cue="Ask for hands: who is not sure their project has a user?">
    <p>
      The walking skeleton should run through the riskiest part of the
      project first, so the backbone has to follow it. In a recent year,
      about half the project listings had no clean user journey to map (the
      instruction team's own count).
    </p>
    <p>
      A game is a user journey with the player as the user; a library is one
      with the adopting developer as the user. If the scary part is whether a
      model beats a baseline, map the research chain, even if there is a web
      front end too.
    </p>
  </Notes>
</Slide>

<StatementSlide kicker="Part 2 of 4: minute 4" source="ephira, a user journey; LumiLab, a pipeline; TaxonBodyMassML, a research chain">
  Three examples
  <Notes time="0:10" cue="One backbone type each, in the order of the last slide.">
    <p>
      Each example opens with the project, then its map, then what the team
      did in its year.
    </p>
  </Notes>
</StatementSlide>

<Slide kicker="Example 1: ephira, a user journey" title="A private period tracker, already in both app stores">
  <ul>
    <li>
      <strong>The app:</strong> a menstrual cycle tracker for iOS and Android
      that keeps every record on the phone
    </li>
    <li class="fragment">
      <strong>Where it started:</strong> a previous capstone team built it and
      published it in both app stores
    </li>
    <li class="fragment">
      <strong>The advertised project:</strong> enhance it, with predictions,
      reminders, encrypted backups, easier data entry, tests, and a store
      update
    </li>
  </ul>
  <p class="caption">
    Repository: <a href={ephira.repo.href}>{ephira.repo.text}</a><br />
    Project page: <a href={ephira.page.href}>{ephira.page.text}</a>
  </p>
  <Notes time="0:40" cue="Ask: what should the map's first row hold, for a project like this?">
    <p>
      ephira is open source under the MIT license; its project page calls it
      privacy-focused and local-first, and says the project "involves
      enhancing Ephira's functionality". The app was at version 1.1.0 in
      both stores when the advertised team started.
    </p>
    <p>
      So the map's first row holds what the repository already does, read
      from the code before anyone plans anything; the plans go in the rows
      under it.
    </p>
  </Notes>
</Slide>

<Slide title="ephira: start the map from what already ships" wide>
  <StoryMap {...ephiraMap} />
  <p class="caption caption-tight">
    Also on the <a href={ephira.page.href}>project page</a>: beta tests, docs, a
    store update; start designing and building pregnancy mode
  </p>
  <Notes time="1:10" cue="Read the inherited skeleton left to right, then point at the empty reminders cell.">
    <p>
      The inherited skeleton is what the repository already did the day the
      team started: a password or biometric lock, a full day log, the
      calendar and its filter, export as CSV, JSON, or PDF, and a first
      prediction that added 28 days to the last period but did not work, so
      the card says so. There were no
      reminders, so the inherited skeleton has a gap, and the advertised
      notifications fill it.
    </p>
    <p>
      Release 1 is the advertised deliverables. Prediction from history is
      stated plainly, so it's known. The other four are questions for the
      partner. Reminders come in the two kinds the proposal names: alerts
      about upcoming cycle events, and data-entry reminders. The alerts get
      the question mark because the proposal asks for push notifications,
      and a server-sent alert about a predicted period means the prediction
      leaves the phone; a daily reminder to log needs no data, so it's
      known. Encrypted
      export and import: the proposal says encrypted, but not how the key is
      made or kept, and nobody had designed it. The two cards about data
      entry and charts are the team's reading of "UI/UX improvements".
    </p>
    <p>
      The stretch goal gets its own row because the proposal labels it one:
      opt-in anonymized data collection, under Take the data out because
      it's data leaving the phone. Cloud sync is the team's own assumption:
      the proposal never mentions it, and it's below the line because
      syncing means an account and a sign-in. Beta testing, docs, the store
      update, and pregnancy mode are advertised but aren't activities on
      this backbone, so they sit in the caption.
    </p>
  </Notes>
</Slide>

