    activity: "Reminders",
    ai: "One alert, then times, daily nudge",
    human: "? Period alerts. Log reminders",
    mark: "agree",
  },
  {
    activity: "Data out",
    ai: "Encrypted backup, restore, passphrase",
    human: "Had: export. ? Encrypted export, import",
    mark: "agree",
  },
  {
    activity: "Stores",
    ai: "TestFlight first, then listings, beta",
    human: "No column: a caption line",
    mark: "drops",
  },
  {
    activity: "Pregnancy",
    ai: "Out of scope: design doc only",
    human: "Caption: start design and build",
    mark: "misreads",
  },
];
// The legend's order: the AI tool's mistakes, the human map's, agreement.
const legend: Mark[] = ["replans", "invents", "misreads", "drops", "agree"];
// Draws each "?" in a cell as the amber assumed mark.
const QUESTION = /(\?)/;
const flagged = (text: string) => text.split(QUESTION);

// The AI tool's ephira map as returned, for the side-by-side slide's notes.
const aiOutput = [
  {
    activity: "1. Unlock the app",
    outOfScope: "Cloud accounts or login",
    release1: [
      "Unlock with biometrics",
      "Change passcode",
      "Auto-lock after inactivity",
    ],
    skeleton: "Unlock with a passcode",
  },
