---
// Fall week 2, Workshop 1: User Story Mapping (#466, restructured in #485,
// tightened in #510). Talk in four parts: user stories and story maps,
// ephira mapped by hand and then drafted with an AI tool, two reference
// maps for projects with no user, then the teams' own maps while the
// instruction team walks the room, with an optional show by two volunteer
// teams and a wrap. Every slide explains itself to someone who missed the
// talk. Each link sits on the slide that uses it. Served at
// /decks/fall-week-2/.
import { Image } from "astro:assets";
import lumiLabPhoto from "../assets/decks/lumilab.webp";
import Slide from "../components/deck/Slide.astro";
import StatementSlide from "../components/deck/StatementSlide.astro";
import StoryMap from "../components/deck/StoryMap.astro";
import TitleSlide from "../components/deck/TitleSlide.astro";
import TwoColumnSlide from "../components/deck/TwoColumnSlide.astro";
import { LATE } from "../lib/canvas-entries.mjs";

export const title = "Fall Week 2: User Story Mapping";

// A made-up campus lunch app: the map Part 1 labels part by part, the one
// the release slide in Part 4 labels row by row, and the one its self-check
// holds up against a map of screens.
const lunch = {
  backbone: ["Find food", "Order it", "Pay", "Pick it up"],
  release1: [
    "Filter by diet",
    "Save a usual order",
    "Pay with dining dollars",
    "Text me when ready",
  ],
  release2: [undefined, undefined, undefined, "? Rate the meal"],
  skeleton: [
    "List open cafes",
    "Choose from a menu",
    "Pay by card",
    "Show a pickup code",
  ],
};

// What a team leaves the session with: the opening slide promises it, and
// the wrap checks it.
const outcome = [
  "A backbone: the top row, four columns or more",
  "A walking-skeleton row: a card in every column",
  "A ? on every card that is a guess",
  "A question for your partner for every ?",
];
// Sets each ? in an outcome line as code, as the template writes it.
const QUESTION = /(\?)/;

// Each example's links, shown without the protocol, as the room would type
// them.
const PROTOCOL = /^https:\/\//;
const link = (url: string) => ({ href: url, text: url.replace(PROTOCOL, "") });
const ephira = {
  page: link(
    "https://capstone.eecs.oregonstate.edu/projects/32032898-6457-5a14-b451-2f1c1a97501a"
  ),
  repo: link("https://github.com/adulbrich/ephira"),
};
const lumiLab = {
  page: link(
    "https://capstone.eecs.oregonstate.edu/projects/4e8e30be-72ac-5203-83fd-f4515162ce75"
  ),
  repo: link("https://github.com/radiantlab/LumiLab"),
};
const taxon = {
  page: link(
    "https://capstone.eecs.oregonstate.edu/projects/1e6e1a34-dee3-54bf-8c53-f876fb2d1519"
  ),
  repo: link("https://github.com/TaxonBodyMassML/TaxonBodyMassML"),
};
const patton = link("https://jpattonassociates.com/the-new-backlog/");
const nngroup = link("https://www.nngroup.com/articles/user-story-mapping/");
// The tutorial the LumiLab map's columns come from.
const pierson = link("https://doi.org/10.1080/15502724.2019.1684319");

// The ephira map, drawn as an inherited codebase: the walking skeleton is
// what the repository already did when the advertised team started, and
// Release 1 is the advertised deliverables. The stretch goal keeps its own
// row, as the proposal labels it.
const ephiraMap = {
  backbone: [
    "Get in safely",
    "Log a day",
    "Review the calendar",
    "See predictions",
    "Get reminders",
    "Take the data out",
  ],
  releases: [
    {
      name: "Inherited skeleton",
      stories: [
        "Password or biometric lock",
        "Full day log",
        "Calendar with a filter",
        "28-day guess, not working",
        undefined,
        "CSV, JSON, or PDF export",
      ],
    },
    {
      name: "Release 1",
      stories: [
        undefined,
        "? Easier data entry",
        "? Clearer cycle charts",
        "Predict from history",
        ["? Period alerts", "Log reminders"],
        "? Encrypted export, import",
      ],
    },
    {
      name: "Stretch goal",
      stories: [
        undefined,
        undefined,
        undefined,
        undefined,
        undefined,
        "Anonymized data, opt-in",
      ],
    },
    {
      name: "Out of scope",
      stories: ["Cloud sync"],
    },
  ],
};

// Handbook links, shown without their protocol, as the room would type
// them.
const handbook = (path: string) => {
  const url = new URL(path, Astro.site);
  return { href: url.href, text: `${url.host}${url.pathname}${url.hash}` };
};
const template = handbook("/story-map-template.xlsx");
const activity = handbook("/activities/requirements/#user-story-mapping");
const guide = handbook("/guides/requirements/#story-mapping");
---

<TitleSlide
  kicker="CS 461, fall week 2: Workshop 1"
  title="User Story Mapping"
  subtitle="A backbone, a release line, and a walking skeleton for your project"
  byline="CS 461: the instruction team"
/>

<Slide kicker="Today's outcome" title="By the end of the session, your team has a first map">
  <ul>
    {
      outcome.map((line) => (
        <li>{line.split(QUESTION).map((part) => (part === "?" ? <code>?</code> : part))}</li>
      ))
    }
  </ul>
  <p class="deck-small after-list">
    Why it matters: the map becomes <code>docs/requirements.md</code> at Repo
    Checkpoint 1, and its <code>?</code> cards are the agenda for your first
    partner meeting.
  </p>
</Slide>

<Slide kicker="Workshop 1" title="Graded complete or incomplete">
  <ul>
    <li>Complete when it's the activity's output: there is no quality bar</li>
    <li>{LATE["class-week"].text}</li>
    <li>
      Submitting an AI-generated output without running the activity as a
      team scores Incomplete
    </li>
  </ul>
  <p class="caption">
    Read for this session:<br />
    Requirements guide, Story Mapping: <a href={guide.href}>{guide.text}</a><br />
    Nielsen Norman Group, User Story Mapping: <a href={nngroup.href}>{nngroup.text}</a>
  </p>
</Slide>

<Slide kicker="Agenda" title="Today, in four parts">
  <ol>
    <li>User stories and story maps</li>
    <li>ephira, a user journey: mapped by hand, then drafted with AI</li>
    <li>
      Reference maps for projects with no user: LumiLab (pipeline),
      TaxonBodyMassML (research chain)
    </li>
    <li>Your turn: map in teams</li>
  </ol>
</Slide>

<Slide kicker="Part 1 of 4: user stories and story maps" title="A user story is one thing a person can do">
  <p class="story-def">
    Small enough to finish in one sprint (two weeks), and written so anyone
    can check it works
  </p>
  <div class="story-shape fragment">
    <div class="story-part">
      <p class="slot">As a <span class="blank">who</span></p>
      <p class="fill">someone tracking their cycle,</p>
    </div>
    <div class="story-part">
      <p class="slot">I want <span class="blank">what</span></p>
      <p class="fill">my next period predicted from my own history,</p>
    </div>
    <div class="story-part">
      <p class="slot">so that <span class="blank">why</span></p>
      <p class="fill">I can plan around it</p>
    </div>
  </div>
  <div class="story-card fragment">
    <span class="card-arrow" aria-hidden="true"></span>
    <span class="map-card">Predict from history</span>
    <p>On a story map, the card holds only the short version</p>
  </div>
  <p class="caption fragment">
    On a pipeline or research map, a card is one piece of work instead: one
    stage, one experiment.
  </p>
</Slide>

<Slide kicker="Part 1 of 4: user stories and story maps" title="What a story map is made of" wide>
  <StoryMap
    backbone={lunch.backbone}
    releases={[
      { name: "Walking skeleton", stories: lunch.skeleton },
      { name: "Release 1", stories: lunch.release1 },
      { name: "Release 2", stories: lunch.release2 },
    ]}
    callouts={[
      { at: "backbone", term: "Backbone: the top row", text: "what people do, in order" },
      { at: "row", row: 0, term: "Walking skeleton", text: "the fall's: one thin path through every column" },
      { at: "line", row: 1, term: "Release 1", text: "the first iteration after the skeleton" },
      { at: "card", row: 2, column: 3, term: "A ? card", text: "a guess nobody has checked with the partner yet" },
    ]}
    legend={false}
    stepped
  />
  <p class="caption caption-tight">
    Add Release 2 and later rows as you need; Out of scope this year is always
    the last row. Jeff Patton, The New User Story Backlog is a Map: <a href={patton.href}>{patton.text}</a>
  </p>
</Slide>

<Slide kicker="Part 1 of 4: user stories and story maps" title="Choose the backbone where your hardest unknowns live" wide>
  <div class="backbones">
    <div class="type">
      <h3>User journey</h3>
      <p>What a user does, in order</p>
      <p class="skeleton">Skeleton: one user gets through every activity once</p>
      <p class="skeleton">
        More than one kind of user? One map: the primary user's flow, with
        parallel columns only where another user's path diverges
      </p>
    </div>
    <div class="type fragment">
      <h3>Pipeline stages</h3>
      <p>What happens to one input on its way to an output</p>
      <p class="skeleton">Skeleton: one real input reaches an output, stubs allowed</p>
      <p class="skeleton">Reference map: LumiLab</p>
    </div>
    <div class="type fragment">
      <h3>Research chain</h3>
      <p>Question, data, baseline, method, evaluation, result</p>
      <p class="skeleton">Skeleton: the baseline runs end to end and produces one number</p>
      <p class="skeleton">Reference map: TaxonBodyMassML</p>
    </div>
  </div>
  <p class="fragment rule-line">
    Same rows and <code>?</code> flags for all three. Write one line saying
    why you chose yours.
  </p>
</Slide>

<StatementSlide kicker="Part 2 of 4" source="ephira, a user journey: mapped by hand, then drafted with AI">
  One proposal, mapped twice
</StatementSlide>

<Slide kicker="Example: ephira, a user journey" title="A private period tracker, already in both app stores">
  <ul>
    <li>
      <strong>The app:</strong> a menstrual cycle tracker for iOS and Android
      that keeps every record on the phone
    </li>
    <li class="fragment">
      <strong>Where it started:</strong> a previous capstone team built it and
      published it in both app stores
    </li>
    <li class="fragment">
      <strong>The advertised project:</strong> enhance it, with predictions,
      reminders, encrypted backups, easier data entry, tests, and a store
      update
    </li>
  </ul>
  <p class="caption">
    Repository: <a href={ephira.repo.href}>{ephira.repo.text}</a><br />
    Project page: <a href={ephira.page.href}>{ephira.page.text}</a>
  </p>
</Slide>

<Slide title="ephira: start the map from what already ships" wide>
  <StoryMap {...ephiraMap} />
  <p class="caption caption-tight">
    Also on the <a href={ephira.page.href}>project page</a>: beta tests, docs, a
    store update; start designing and building pregnancy mode
  </p>
</Slide>

<TwoColumnSlide kicker="Example: ephira, what happened" title="What the team built in its year" divider>
  <div slot="left">
    <h3>Added</h3>
    <ul class="reveal-list">
      <li>Faster logging: a chip grid and one-tap birth control</li>
      <li>A Cycle tab: predictions from average cycle length, phases, and tips</li>
      <li>Alerts before a predicted period, scheduled on the phone</li>
      <li>A guided walkthrough, and the first pregnancy mode tabs</li>
      <li>Unit tests, and app version 1.1.0 to 1.3.0</li>
    </ul>
  </div>
  <div slot="right">
    <h3>Not built</h3>
    <ul class="reveal-list">
      <li>Encrypted export and import: the export is still the inherited one, with no import</li>
      <li>Reminders to log a day: a message template, never scheduled</li>
      <li>Integration and end-to-end tests: unit tests only</li>
      <li>Cloud sync and the stretch goal: not attempted</li>
    </ul>
    <p class="caption">
      Repository history over the team's year; later commits are the
      maintainer's: <a href={ephira.repo.href}>{ephira.repo.text}</a>
    </p>
  </div>
</TwoColumnSlide>

<StatementSlide kicker="Example: ephira, drafted with AI" source="ephira again: the proposal alone, given to an AI tool">
  The same proposal, drafted by AI
</StatementSlide>

<Slide kicker="The prompt" title="One prompt, the proposal, no repository">
  <pre class="prompt">Here is a software project proposal, as it was advertised to students:

[ephira's project page, as advertised]

Draft a user story map for the team's first release. Give a backbone of
four to seven activities in the order they happen, then a walking-skeleton
row with one story under every activity, then a Release 1 row and an
out-of-scope row. Keep each story under eight words.</pre>
  <p class="caption">
    Run on Sonnet 5.5 as a Claude Code sub-agent with its tools off, so it
    could not open the repository. Project page: <a href={ephira.page.href}>{ephira.page.text}</a>
  </p>
</Slide>

<StatementSlide kicker="What the tool did" source="Its walking skeleton planned the lock, the day log, and the calendar the app already had">
  Given the proposal alone, the tool planned to rebuild an app already in both stores
</StatementSlide>

<Slide kicker="Drafting a map with an AI tool" title="Give it all your context, and make it flag its guesses">
  <ol>
    <li>
      Prompt with the project description and every piece of context you
      have: the inherited code, papers your partner cites, earlier teams'
      documents
    </li>
    <li class="fragment">Ask for the map in the template's rows</li>
    <li class="fragment">
      Ask it to start with <code>?</code> every card it can't trace to the
      context you gave it
    </li>
    <li class="fragment">Check each card against the code, then with your partner</li>
  </ol>
  <p class="deck-small after-list fragment">
    Give it only what your Team Charter's AI and Confidentiality section
    allows.
  </p>
</Slide>

<StatementSlide kicker="Part 3 of 4" source="LumiLab, a pipeline; TaxonBodyMassML, a research chain">
  Reference maps for projects with no user
</StatementSlide>

<Slide kicker="Reference map: LumiLab, a pipeline" title="Measuring glare from ordinary photos">
  <div class="with-photo">
    <ul>
      <li>
        <strong>Glare:</strong> light bright enough to make seeing
        uncomfortable. Measuring it takes a luminance camera, which few can
        afford
      </li>
      <li class="fragment">
        <strong>What goes in:</strong> the same scene photographed several
        times, dark to bright, with an ordinary camera, plus that camera's
        calibration files
      </li>
      <li class="fragment">
        <strong>What comes out:</strong> a luminance map, an image where every
        pixel holds how bright that spot was, in measured units
      </li>
      <li class="fragment">
        <strong>Who uses it:</strong> lighting designers and daylighting
        researchers
      </li>
    </ul>
    <Image
      src={lumiLabPhoto}
      alt="Two fisheye photos of office desks by a window, each beside its luminance map in false color, with the windows in yellow"
      width={400}
    />
  </div>
  <p class="caption">
    Repository: <a href={lumiLab.repo.href}>{lumiLab.repo.text}</a><br />
    Project page: <a href={lumiLab.page.href}>{lumiLab.page.text}</a>
  </p>
</Slide>

<Slide kicker="Reference map: LumiLab" title="The tutorial's steps: a script, then an app" wide>
  <StoryMap
    backbone={[
      "Select exposures",
      "Merge, nullify exposure",
      "Crop and resize",
      "Projection, vignetting, ND filter",
      "Scale to the meter",
      "Edit the header",
      "Check validity",
    ]}
    releases={[
      {
        name: "Walking skeleton",
        goal: "one script, one photo set",
        stories: [
          "Keep frames by pixel count",
          ["Merge with hdrgen", "Nullify exposure"],
          "Crop to the lens, shrink",
          ["Fisheye file", "Vignetting file", "ND filter file"],
          "One fixed factor",
          "Write the view line",
          "Lux against the meter",
        ],
      },
      {
        name: "Release 1",
        goal: "the app over the script",
        stories: [
          "Pick photos or a folder",
          "Upload the response file",
          "Type crop and size numbers",
          "Upload the .cal files",
          "? Type a meter reading",
          "Type the viewing angles",
          "Run all, view the map",
        ],
      },
    ]}
    legend={false}
  />
  <p class="caption caption-tight">
    Simplified to fit the slide: two columns group the tutorial's steps (3
    and 4; 6 to 8). Columns: steps 2 to 11 of Table 3 in Pierson, Cauwerts,
    Bodart, and Wienold, "Tutorial: Luminance Maps for Daylighting Studies
    from High Dynamic Range Photography": <a href={pierson.href}>{pierson.text}</a>
  </p>
</Slide>

<Slide kicker="Reference map: TaxonBodyMassML, a research chain" title="Estimating a species' weight from its name">
  <ul>
    <li>
      <strong>The project:</strong> a model that estimates how much a species
      weighs from its scientific name and its relatives
    </li>
    <li class="fragment">
      <strong>Who uses the result:</strong> ecologists, who need the weight of
      species nobody has weighed
    </li>
    <li class="fragment">
      <strong>What goes in:</strong> one species name, or a list of them
    </li>
    <li class="fragment">
      <strong>What comes out:</strong> a weight estimate, where it came from,
      and how sure the model is
    </li>
  </ul>
  <p class="caption">
    Repository: <a href={taxon.repo.href}>{taxon.repo.text}</a><br />
    Project page: <a href={taxon.page.href}>{taxon.page.text}</a>
  </p>
</Slide>

<Slide kicker="Reference map: TaxonBodyMassML" title="The weight model as a research chain" wide>
  <StoryMap
    backbone={[
      "Question",
      "Data",
      "Baseline",
      "Method",
      "Evaluation",
      "Result",
    ]}
    releases={[
      {
        name: "Walking skeleton",
        goal: "the fall's, end to end",
        stories: [
          "Mass from a species name",
          "Measured masses, 90/10 split",
          "? A simple model to beat",
          "A first model",
          "Error on the held-out tenth",
          "One estimate per name",
        ],
      },
      {
        name: "Release 1",
        goal: "built in winter and spring",
        stories: [
          "95 of 100 in the right order of magnitude",
          ["Full taxonomy, GBIF and NCBI", "Masses in log10"],
          undefined,
          "Boosted trees on the taxonomy",
          "RMSE and R² in log10",
          ["Measured mass, or an estimate with a 90% interval", "Two web services"],
        ],
      },
    ]}
    legend={false}
  />
  <p class="caption caption-tight">
    From the team's repository. The method changed from a language model to
    boosted trees, and only the Method column moved. Amber marks the baseline
    the repository never had: Baseline and Evaluation are the cards a
    research team skips, and the 95 of 100 target was never computed.
  </p>
</Slide>

<StatementSlide kicker="Part 4 of 4" source="Map in teams while the instruction team walks the room; two teams may show their maps">
  Your turn
</StatementSlide>

<Slide kicker="Work time" title="Start here, as a team">
  <ol class="steps" style="--steps: 5;">
    <li>
      <p>Open the story map template, one laptop per team</p>
      <span class="art art-sheet" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i></span>
    </li>
    <li>
      <p>Pick the kind of top row (Backbone type): user journey, pipeline, or research chain</p>
      <span class="art art-pick" aria-hidden="true">User journey</span>
    </li>
    <li>
      <p>Fill the top row (Backbone): four or more steps, in order</p>
      <span class="art art-row" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
    </li>
    <li>
      <p>Fill one thin row under it (Walking skeleton): a card in every column</p>
      <span class="art art-row art-two" aria-hidden="true"><i></i><i></i><i></i><i></i><b></b><b></b><b></b><b></b></span>
    </li>
    <li>
      <p>Start every guess with <code>?</code> and add a question for it on the second tab</p>
      <span class="art art-guess" aria-hidden="true">?</span>
    </li>
  </ol>
  <p class="caption">Template: <a href={template.href}>{template.text}</a></p>
</Slide>

<Slide kicker="Work time: then" title="Then fill the rows under the skeleton" wide>
  <StoryMap
    backbone={lunch.backbone}
    releases={[
      { name: "Walking skeleton", stories: lunch.skeleton },
      { name: "Release 1", stories: lunch.release1 },
      { name: "Release 2", stories: lunch.release2 },
      { name: "Out of scope this year", stories: [undefined, undefined, undefined, "Delivery to dorms"] },
    ]}
    callouts={[
      { at: "row", row: 0, term: "Walking skeleton", text: "the fall's" },
      { at: "row", row: 1, term: "Release 1", text: "the first iteration after it" },
      { at: "row", row: 2, term: "Release 2 and on", text: "insert a row per release" },
      { at: "row", row: 3, term: "Out of scope this year", text: "always the last row" },
    ]}
    legend={false}
  />
  <p class="caption caption-tight">
    Scope is per card, never per column: in a release row, it's in; in the
    last row, it's out.
  </p>
</Slide>

<Slide kicker="Optional: two teams show their maps" title="Two volunteer teams show their top row">
  <ol class="steps" style="--steps: 3;">
    <li>
      <p>A team volunteers and puts its map on the big screen</p>
    </li>
    <li>
      <p>It reads its top row aloud, left to right, as one story</p>
    </li>
    <li>
      <p>Two minutes of feedback from the room: one thing that works, one thing to change</p>
    </li>
  </ol>
  <p class="rule-line">
    Two teams, two minutes each. If your partner asked you to keep the project
    confidential (an NDA), don't volunteer.
  </p>
</Slide>

<Slide kicker="Work time: check your map" title="Check your map: steps people take, not screens" wide>
  <p class="verdict verdict-yes">Like this</p>
  <StoryMap
    backbone={lunch.backbone}
    releases={[
      {
        name: "Walking skeleton",
        stories: [lunch.skeleton[0], lunch.skeleton[1], "? Pay with dining dollars", lunch.skeleton[3]],
      },
    ]}
    callouts={[
      { at: "backbone", term: "What people do, in order" },
      { at: "row", row: 0, term: "A card in every column; a ? on each guess" },
    ]}
    legend={false}
  />
  <p class="verdict verdict-no">Not like this</p>
  <StoryMap
    backbone={["Home page", "Menu page", "Database", "Payment API"]}
    releases={[
      {
        name: "Walking skeleton",
        stories: ["Log in", "Show menu", undefined, "Charge card"],
      },
    ]}
    callouts={[
      { at: "backbone", term: "Screens and parts of the code" },
      { at: "row", row: 0, term: "A gap: not end to end" },
    ]}
  />
  <p class="caption caption-tight">
    Also check: one line on why this backbone type, and a question on the
    second tab for every <code>?</code>. A gap in the skeleton? Fill it
    before Release 1, however unsure the card.
  </p>
</Slide>

<Slide kicker="Wrap" title="Check your map against today's outcome">
  <ul>
    {
      outcome.map((line) => (
        <li>{line.split(QUESTION).map((part) => (part === "?" ? <code>?</code> : part))}</li>
      ))
    }
  </ul>
  <p class="deck-small after-list">
    Stuck? The activity: <a href={activity.href}>{activity.text}</a><br />
    The Requirements guide, Story Mapping: <a href={guide.href}>{guide.text}</a>
  </p>
</Slide>

<Slide kicker="Wrap" title="Due by Sunday of week 2: one PDF">
  <ul class="due">
    <li>
      A map of your project's main flows: four backbone columns or more, and
      one complete walking-skeleton row
    </li>
    <li>The backbone type, with one line saying why</li>
    <li>Your stories, each in a release row or in Out of scope this year</li>
    <li>The Questions for our partner tab: one question per <code>?</code></li>
    <li>The whole workbook, both tabs: in Google Sheets, choose Workbook, not Current sheet</li>
  </ul>
  <p class="deck-small after-list">
