---
// Fall week 7: Workshop 4, Peer Technical Design Review, in the week 2
// deck's shape. An opening (the outcome, what it feeds, scoring and reading,
// the three steps); the talk (what a design review is for, who a team pairs
// with, then the campus lunch app of weeks 2 and 3 taken through the steps:
// its introduction and the diagram in its design document, the other team's
// written answers, the log of comments, and what an answer a team can act on
// reads like); the two fallbacks; then one slide per step for the teams to
// work from, a self-check, and the wrap. The step names, their minutes, and
// the reviewer questions come from the activity page; the weeks on the
// timeline, the reading, and the week's other Due items from the schedule;
// the submission from the workshop page.
// Every slide explains itself to someone who missed the talk. Each link
// sits on the slide that uses it. Served at /decks/fall-week-7/.
import LinkedText from "../components/deck/LinkedText.astro";
import Slide from "../components/deck/Slide.astro";
import StatementSlide from "../components/deck/StatementSlide.astro";
import TitleSlide from "../components/deck/TitleSlide.astro";
import activities from "../content/docs/activities/technical-design.mdx?raw";
import workshops from "../content/docs/assignments/workshop-activities.mdx?raw";
import schedule from "../content/docs/introduction/schedule.mdx?raw";
import { LATE } from "../lib/canvas-entries.mjs";
import { linkHrefs, plainText } from "../lib/deck-text.mjs";
import { termWeeks, weekWhere } from "../lib/schedule-lines.mjs";

export const title = "Fall Week 7: Peer Technical Design Review";

// Handbook links, each shown by its page's name, since the slides are shared
// with the class.
const handbook = (path: string) => new URL(path, Astro.site).href;
const ACTIVITY_PATH =
  "/activities/technical-design/#peer-technical-design-review";
const DESIGN_REVIEWS = "/guides/presentations/#design-reviews";
const RFC_PAGE = "/assignments/rfc/";
const DEFENSE_PAGE = "/assignments/defense/";
const WORKSHOPS_PAGE = "/assignments/workshop-activities/";
const activityLink = handbook(ACTIVITY_PATH);

// The activity as its page writes it: the three steps with their minutes,
// and the questions a reviewer answers. The build fails when the page drops
// either, rather than the deck going stale.
const ACTIVITY_HEADING = "\n## Peer Technical Design Review";
const activityStart = activities.indexOf(ACTIVITY_HEADING);
const activityEnd = activities.indexOf("\n## ", activityStart + 1);
const activity =
  activityStart < 0
    ? ""
    : activities.slice(
        activityStart,
        activityEnd < 0 ? undefined : activityEnd
      );
const STEP_RE = /^- \*\*(.+?)\*\*: (\d+ minutes(?: per team)?)/gm;
const steps = [...activity.matchAll(STEP_RE)].map(([, name, time]) => ({
  name,
  time,
}));

const REVIEWER_LEAD =
  "As a reviewer, answer these about the other team's document:";
const afterLead =
  activity.split(REVIEWER_LEAD)[1]?.trimStart().split("\n") ?? [];
const firstOther = afterLead.findIndex((line) => !line.startsWith("- "));
const questions = afterLead
  .slice(0, firstOther < 0 ? undefined : firstOther)
  .map((line) => plainText(line.slice(2).trim()));
if (questions.length === 0) {
  throw new Error(
    "fall-week-7: the activity page gives Peer Technical Design Review no reviewer questions."
  );
}

// What each step is done from or on, in slide wording.
const stepNotes = [
  "Introduce the project, then walk through your design document",
  `Their document: ${questions.length} questions, answered in writing`,
  "Each comment given a priority or declined",
];
if (steps.length !== stepNotes.length) {
  throw new Error(
    `fall-week-7: the activity page gives Peer Technical Design Review ${steps.length} timed steps, and this deck presents ${stepNotes.length}.`
  );
}
const [present, review, log] = steps;
const stepKicker = (step: (typeof steps)[number]) =>
  `Step ${steps.indexOf(step) + 1} of ${steps.length}: ${step.time}`;

// What a team leaves with: the opening slide promises it, and the wrap
// checks it.
const outcome = [
  "Your technical design document, presented to another team",
  `Their written answers to the ${questions.length} review questions`,
  "A log of the points they made, each given a priority or declined with a reason",
];

// The fall schedule, read as <TermSessions> reads it. A line is found by
// where its links point, so rewording it doesn't lose it.
const WEEK = 7;
const fall = termWeeks(schedule, "fall");
const rowsOf = (week: number) =>
  fall.find((found) => found.week === week)?.rows;
const links = (href: string, word?: string) => (line: string) =>
  linkHrefs(line).includes(href) && (!word || plainText(line).includes(word));
function weekOf(label: string, test: (line: string) => boolean, what: string) {
  const week = weekWhere(fall, label, test);
  if (week === undefined) {
    throw new Error(
      `fall-week-7: no ${label} line on the fall schedule for ${what}.`
    );
  }
  return week;
}
// Due this week besides the workshop submission the due slide spells out.
const alsoDue = (rowsOf(WEEK)?.get("Due")?.items ?? []).filter(
  (item) => !linkHrefs(item).some((href) => href.startsWith(WORKSHOPS_PAGE))
);
// The reading behind this session sits on an earlier week's Read line.
const readWeek = weekOf(
  "Read",
  links(DESIGN_REVIEWS),
  "the design reviews reading"
);
const readLine = rowsOf(readWeek)?.get("Read")?.text ?? "";

interface Feed {
  detail: string;
  href?: string;
  today?: boolean;
  week: number;
  what: string;
  when: string;
}
// What today's output feeds, in schedule order.
const feedList: Feed[] = [
  {
    detail: "Your design document as you presented it, and the log",
    today: true,
    week: WEEK,
    what: "Workshop 4",
    when: "Sunday",
  },
  {
    detail:
      "Its revision log works like today's log: each review point changed or declined, with where or why",
    href: handbook(`${RFC_PAGE}#revision-log`),
    week: weekOf("Due", links(RFC_PAGE, "final"), "the RFC final"),
    what: "RFC final",
    when: "Sunday",
  },
  {
    detail:
      "Its technical depth question: what breaks in your work if X changes?",
    href: handbook(DEFENSE_PAGE),
    week: weekOf("Due", links(DEFENSE_PAGE), "the defense"),
    what: "Defense",
    when: "or later",
  },
  {
    detail: "Its PDF holds docs/design.md, with the changes from today's log",
    href: handbook(
      "/assignments/repo-checkpoints/#repo-checkpoint-2-hello-production"
    ),
    week: weekOf(
      "Due",
      links(
        "/assignments/repo-checkpoints/#repo-checkpoint-2-hello-production"
      ),
      "Repo Checkpoint 2"
    ),
    what: "Repo Checkpoint 2",
    when: "Sunday",
  },
];
const feeds = [...feedList].sort((a, b) => a.week - b.week);
const lastWeek = feeds.at(-1)?.week;

// The complete-submission line, as the workshop page states it under its
// fall workshops.
const WORKSHOP = 4;
const fallWorkshops = workshops.slice(
  workshops.indexOf("\n## Fall"),
  workshops.indexOf("\n## Winter")
);
const SUBMISSION = "- **A complete submission:** ";
const submissionLine = fallWorkshops
  .split(`\n### Workshop ${WORKSHOP}:`)[1]
  ?.split("\n")
  .find((text) => text.startsWith(SUBMISSION));
if (!submissionLine) {
  throw new Error(
    `fall-week-7: the workshop page gives fall Workshop ${WORKSHOP} no complete submission.`
  );
}
const submission = plainText(submissionLine.slice(SUBMISSION.length));

// The campus lunch app of weeks 2 and 3, with week 3's choices made. The
// other team's written answers, one per reviewer question in the page's
// order, each naming the section it is about; then the lunch team's log.
const lunchAnswers = [
  {
    answer: "We couldn't tell what a past order shows once its dish is deleted",
    asks: "Can you follow it without the code?",
    section: "Data model",
  },
  {
    answer:
      "The diagram lives in a whiteboard app, so it won't change when the document does",
    asks: "Diagrams kept with it?",
    section: "Architecture",
  },
  {
    answer:
      "Copying each dish's name and price into the order when it's placed",
    asks: "An alternative missing?",
    section: "Data model",
  },
  {
    answer:
      "It assumes every text arrives; when one doesn't, the student never learns the order is ready",
    asks: "If the main assumption changed?",
    section: "Pickup",
  },
  {
    answer: "Copy the name and price into the order",
    asks: "The first change?",
    section: "Data model",
  },
];
if (lunchAnswers.length !== questions.length) {
  throw new Error(
    `fall-week-7: the activity page gives ${questions.length} reviewer questions, and the lunch app's example answers ${lunchAnswers.length}.`
  );
}
const lunchLog = [
  {
    comment: "Copy each dish's name and price into the order when it's placed",
    priority: 1,
  },
  {
    comment: "Say what the student sees when the text never arrives",
    priority: 2,
  },
  {
    comment: "Keep the architecture diagram in the repository, beside the text",
    priority: 3,
  },
  {
    comment: "Draw pickup from placed to picked up",
    declined: "Pickup has two states, and the text names both",
  },
];
---

<TitleSlide
  kicker="CS 461, fall week 7: Workshop 4"
  title="Peer Technical Design Review"
  subtitle="Present your design document to another team, and review theirs"
  byline="CS 461: the instruction team"
/>

<Slide kicker="Today's outcome" title="By the end of the session, your team has a reviewed design">
  <ul>{outcome.map((line) => <li>{line}</li>)}</ul>
</Slide>

<Slide kicker="What today feeds" title={`Your reviewed design, through week ${lastWeek}`} wide>
  <div class="timeline" role="list">
    {
      feeds.map((entry) => (
        <div class:list={["entry", { today: entry.today }]} role="listitem">
          <span class="when">
            Week {entry.week}
            , {entry.when}
          </span>
          <span class="dot" aria-hidden="true" />
          <span class="what">
            {entry.href ? <a href={entry.href}>{entry.what}</a> : entry.what}
            <span class="detail">{entry.detail}</span>
          </span>
        </div>
      ))
    }
  </div>
  <p class="caption">
    Afterward, turn the comments you gave a priority into edits to
    <code>docs/design.md</code> or into ADRs.
  </p>
</Slide>

<Slide kicker="Workshop 4" title="Graded complete or incomplete">
  <ul>
    <li>Complete when it holds everything listed as due: there is no quality bar</li>
    <li>{LATE["class-week"].text}</li>
    <li>
      A submission that is not about your own project or team, such as a
      generic output produced without your team's material, scores Incomplete
    </li>
  </ul>
  <p class="caption">
    The reading behind this session, from week {readWeek}:<br />
    <LinkedText md={readLine} />
  </p>
</Slide>

<Slide kicker="Agenda" title="A short talk, then three steps with the team at the next table" wide>
  <p class="lead">
    First, the talk: what a design review is for, and the campus lunch app's
    design document taken through the steps. Then your own:
  </p>
  <ol class="steps" style={`--steps: ${steps.length};`}>
    {
      steps.map((step, index) => (
        <li>
          <p>
            <strong>{step.name}</strong>
          </p>
          <p class="note">{stepNotes[index]}</p>
          <span class="art art-count">{step.time}</span>
        </li>
      ))
    }
  </ol>
</Slide>

<Slide kicker="Workshop 4: what a design review is for" title="Find the problem while it's cheap to fix" wide>
  <ul>
    <li>
      You show the design before your team builds more on it, and the other
      team says what breaks
    </li>
    <li class="fragment">
      Treat a hard question as help: a review that changes nothing may mean
      nobody felt able to object
    </li>
  </ul>
  <div class="pair fragment">
    <div class="box">
      <h3>Found in today's review</h3>
      <p>Costs a conversation</p>
    </div>
    <div class="box box-accent">
      <h3>Found while you build</h3>
      <p>Costs the code already built on top of it</p>
    </div>
  </div>
  <p class="caption">
    From the Presentations guide: <a href={handbook(DESIGN_REVIEWS)}>Design Reviews</a>
  </p>
</Slide>

<Slide kicker="Workshop 4: who you work with" title="Pair with the team at the next table, for the whole session">
  <ul>
    <li>You present your design document to them and review theirs; they do the same</li>
    <li>With an odd number of teams, three teams review in a ring</li>
    <li>Nothing is prepared before class: present the document as it stands</li>
  </ul>
  <p class="caption">
    Under NDA? The other team hears your introduction and reads your document:
    describe each component by its role (a message queue, a model server) and
    leave out the partner's specifics. If that isn't possible, tell the
    instruction team now.
  </p>
</Slide>

<Slide kicker="Example: the campus lunch app, step 1" title="The lunch team introduces the project first" wide>
  <div class="cards">
    <div class="card">
      <h3>The problem it solves</h3>
      <p>
        The lunch line at the campus cafes runs past the break, so students
        order ahead and pick up.
      </p>
    </div>
    <div class="card">
      <h3>Who it's for</h3>
      <p>
        Students who order, and the cooks who fill each order from a kitchen
        screen.
      </p>
    </div>
    <div class="card">
      <h3>What it connects to</h3>
      <p>
        Supabase for sign-in and data, Stripe for payment, and a text message
        for pickup.
      </p>
    </div>
  </div>
  <p class="caption">
    Then the design document, starting with the decision the team is least
    sure of.
  </p>
</Slide>

<Slide kicker="Example: the campus lunch app, step 1" title="The diagram in the lunch app's design document" wide>
  <div class="design" role="img" aria-label="The lunch app's design: a student web app and a kitchen dashboard, both built with React, read and write Supabase, which holds sign-in and a Postgres database of cafes, dishes, and orders. Stripe takes the card payment and tells Supabase when it clears. A text message tells the student the order is ready. The database is marked as the decision the team is least sure of: an order points at its dish rows.">
    <div class="part" style="grid-area: 1 / 1;">
      <h3>Student web app</h3>
      <p>React, hosted on Vercel</p>
    </div>
    <div class="flow" style="grid-area: 1 / 2;">
      <span>menu, cart, orders</span>
      <i class="arrow"></i>
    </div>
    <div class="part store" style="grid-area: 1 / 3 / span 2;">
      <h3>Supabase</h3>
      <p class="inner">Sign-in: student accounts</p>
      <p class="inner unsure">
        Postgres: cafes, dishes, orders
        <strong>Least sure: an order points at its dish rows</strong>
      </p>
    </div>
    <div class="flow" style="grid-area: 1 / 4;">
      <span>payment cleared</span>
      <i class="arrow arrow-back"></i>
    </div>
    <div class="part" style="grid-area: 1 / 5;">
      <h3>Stripe</h3>
      <p>Takes the card payment</p>
    </div>
    <div class="part" style="grid-area: 2 / 1;">
      <h3>Kitchen dashboard</h3>
      <p>React, one screen in each cafe</p>
    </div>
    <div class="flow" style="grid-area: 2 / 2;">
      <span>asks for new orders every 5 seconds</span>
      <i class="arrow"></i>
    </div>
    <div class="flow" style="grid-area: 2 / 4;">
      <span>order ready</span>
      <i class="arrow"></i>
    </div>
    <div class="part" style="grid-area: 2 / 5;">
      <h3>Text message</h3>
      <p>Tells the student to pick up</p>
    </div>
  </div>
  <p class="caption caption-tight">
    The document's sections around it: Architecture, Data model, Payments,
    and Pickup. The team opens on the decision marked.
  </p>
</Slide>

<Slide kicker="Example: the campus lunch app, step 2" title="The other team's written answers, each naming a section" wide>
  <table class="rows">
    <thead>
      <tr>
        <th scope="col" class="narrow-col">The question</th>
        <th scope="col">Their answer</th>
      </tr>
    </thead>
    <tbody>
      {
        lunchAnswers.map(({ asks, section, answer }) => (
          <tr>
            <th scope="row">{asks}</th>
            <td>
              <strong>{section}:</strong> {answer}
            </td>
          </tr>
        ))
      }
    </tbody>
  </table>
</Slide>

<Slide kicker="Example: the campus lunch app, step 3" title="The lunch team's log: one comment per point" wide>
  <table class="rows">
    <thead>
      <tr>
        <th scope="col">Comment</th>
        <th scope="col" class="log-col">Priority, or declined</th>
      </tr>
    </thead>
    <tbody>
      {
        lunchLog.map(({ comment, priority, declined }) => (
          <tr>
            <th scope="row">{comment}</th>
            <td>
              {declined ? (
                <>
                  <span class="chip chip-no">Declined</span> {declined}
                </>
              ) : (
                <span class="chip chip-yes">{priority}</span>
              )}
            </td>
          </tr>
        ))
      }
    </tbody>
  </table>
  <p class="caption">
    Three answers point at the first comment, so it's logged once. Priority 1
    is the change the team makes first.
  </p>
</Slide>

<Slide kicker="Workshop 4: writing an answer" title="Write an answer the other team can act on" wide>
  <div class="checks">
    <div>
      <p class="verdict verdict-yes">Like this</p>
      <ul class="says">
        <li>Data model: deleting a dish breaks every past order that points at it</li>
        <li>
          Payments: the document shows no refund. Stripe returns the money,
          and the order still reads paid
        </li>
        <li>
          Architecture: sign-in and orders both live in Supabase, so say what
          moves if the partner leaves it
        </li>
      </ul>
    </div>
    <div>
      <p class="verdict verdict-no">Not like this</p>
      <ul class="says">
        <li>Looks good to us</li>
        <li>Think about scalability</li>
        <li>We'd have used a different database</li>
      </ul>
    </div>
  </div>
  <p class="caption">
    The other team has {log.time} to log every point you make: name the
    section, and say what breaks, what's missing, or what to try instead.
  </p>
</Slide>

<Slide kicker="Workshop 4: if something's missing" title="Two fallbacks, so every team leaves with a log" wide>
  <div class="pair">
    <div class="box">
      <h3>No design document yet</h3>
      <p>
        Spend 20 minutes first on one page: the components, how they connect,
        what each is built with, and the decision you're least sure of
      </p>
    </div>
    <div class="box">
      <h3>No reviewer, or no answers</h3>
      <p>
        Have an agent answer the {questions.length} review questions about
        your document, and log its answers the same way
      </p>
    </div>
  </div>
  <p class="caption">
    Give an agent only what your Team Charter allows.
  </p>
</Slide>

<StatementSlide kicker="Work time" source="One slide per step stays on the screen while you work; the instruction team walks the room">
  Your turn: three steps with the team at the next table
</StatementSlide>

<Slide kicker={stepKicker(present)} title="Introduce your project, then walk through your design document" wide>
  <ul>
    <li>The problem it solves, who it's for, and what it runs in or connects to</li>
    <li>Then the document, starting with the decision you're least sure of</li>
    <li>Answer their questions without defending the design yet: the log comes last</li>
  </ul>
  <p class="caption">
    Then swap, until every team has presented. The activity:
    <a href={activityLink}>Peer Technical Design Review</a>
  </p>
</Slide>

<Slide kicker={stepKicker(review)} title="Answer these about the other team's document" wide>
  <ol>{questions.map((question) => <li>{question}</li>)}</ol>
  <p class="caption">
    Every team at once, in writing, naming the section each answer is about;
    then hand the answers over. With three teams, review the next team's.
  </p>
</Slide>

<Slide kicker={stepKicker(log)} title="Log each point their answers make as a comment" wide>
  <div class="pair">
    <div class="box box-yes">
      <h3>A priority</h3>
      <p>1 is the change you make first, then 2, then 3</p>
    </div>
    <div class="box">
      <h3>Declined</h3>
      <p>One line: why the point doesn't hold for your design</p>
    </div>
  </div>
  <ul class="after-pair">
    <li>One comment per point, however many answers make it</li>
    <li>Name the reviewing team at the top of the log</li>
  </ul>
</Slide>

<Slide kicker="Work time: check your output" title="Check your presentation, answers, and log for four mistakes" wide>
  <table class="rows">
    <thead>
      <tr>
        <th scope="col" class="narrow-col">Mistake</th>
        <th scope="col">Instead of</th>
        <th scope="col">Write or say</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <th scope="row">No problem stated</th>
        <td class="instead">Opening on the database tables</td>
        <td>The problem, who it's for, and what it connects to, then the document</td>
      </tr>
      <tr>
        <th scope="row">No doubt named</th>
        <td class="instead">We're confident in all of it</td>
        <td>The decision your team argued about longest, presented first</td>
      </tr>
      <tr>
        <th scope="row">An answer nobody can act on</th>
        <td class="instead">Think about scalability</td>
        <td>Kitchen dashboard: each screen asks for orders every 5 seconds. What happens at 40 screens?</td>
      </tr>
      <tr>
        <th scope="row">A decline with no reason</th>
        <td class="instead"><span class="chip chip-no">Declined</span></td>
        <td>
          <span class="chip chip-no">Declined</span> Pickup has two states,
          and the text names both
        </td>
      </tr>
    </tbody>
  </table>
</Slide>

<Slide kicker="Wrap" title="Check your work against today's outcome">
  <ul>{outcome.map((line) => <li>{line}</li>)}</ul>
  <p class="caption">
    Stuck? <a href={activityLink}>Peer Technical Design Review</a>
  </p>
</Slide>

<Slide kicker="Wrap" title={`Due by Sunday of week ${WEEK}`}>
  <ul class="due">
    <li>Workshop {WORKSHOP}, one PDF per team: {submission}</li>
    {
      alsoDue.map((item) => (
        <li>
          <LinkedText md={item} />
        </li>
      ))
    }
  </ul>
</Slide>

<style>
  .caption {
    margin-block-start: auto;
    padding-block-start: 24px;
    font-size: var(--deck-text-min);
    color: var(--deck-ink-soft);
  }

  /* Under a drawing that fills the slide at the 32px floor. */
  .caption-tight {
    padding-block-start: 12px;
  }

  /* A one-line fact the slide's tiles depend on. */
  .lead {
    margin: 0 0 32px;
    font-size: 36px;
    color: var(--deck-ink-soft);
  }

  /* Numbered steps drawn as tiles, left to right, each with a chevron into
     the next. */
  .steps {
    display: grid;
    grid-template-columns: repeat(var(--steps), minmax(0, 1fr));
    gap: 56px;
  }

  .steps > li {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 104px 26px 28px;
    margin: 0;
    font-size: 36px;
    line-height: 1.22;
    background: var(--deck-card);
    border: 3px solid var(--deck-rule);
    border-radius: 14px;
  }

  .steps > li::before {
    inset-block-start: 24px;
    inset-inline-start: 24px;
    display: grid;
    place-items: center;
    width: 60px;
    height: 60px;
    font-size: 36px;
    color: var(--deck-paper);
    background: var(--deck-accent-ink);
    border-radius: 999px;
  }

  .steps > li + li::after {
    position: absolute;
    inset-block-start: 36px;
    inset-inline-start: -44px;
    content: "";
    border-block: 18px solid transparent;
    border-inline-start: 26px solid var(--deck-accent);
  }

  .steps p {
    margin: 0;
  }

  .note {
    font-size: var(--deck-text-min);
    color: var(--deck-ink-soft);
  }

  .art {
    margin-block-start: auto;
  }

  .art-count {
    align-self: start;
    padding: 2px 14px;
