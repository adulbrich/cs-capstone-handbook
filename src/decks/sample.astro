---
// The sample deck: every slide component once, at auditorium size. It is
// the reference for writing a deck and the page to check after a change to
// src/styles/deck.css or src/components/deck/. Served at /decks/sample/.
import alexUlbrich from "../assets/decks/alex-ulbrich.jpg";
import kirstenWinters from "../assets/decks/kirsten-winters.jpg";
import sprint from "../assets/design-sprint.png";
import DecisionList from "../components/deck/DecisionList.astro";
import FrameSlide from "../components/deck/FrameSlide.astro";
import GradeGrid from "../components/deck/GradeGrid.astro";
import ImageSlide from "../components/deck/ImageSlide.astro";
import PeopleSlide from "../components/deck/PeopleSlide.astro";
import QrSlide from "../components/deck/QrSlide.astro";
import SafetyNet from "../components/deck/SafetyNet.astro";
import SeatingMap from "../components/deck/SeatingMap.astro";
import Slide from "../components/deck/Slide.astro";
import StatementSlide from "../components/deck/StatementSlide.astro";
import StoryMap from "../components/deck/StoryMap.astro";
import TermSessions from "../components/deck/TermSessions.astro";
import TitleSlide from "../components/deck/TitleSlide.astro";
import TwoColumnSlide from "../components/deck/TwoColumnSlide.astro";

export const title = "Deck Components";

const handbook = new URL("/", Astro.site).href;
---

<TitleSlide
  kicker="Handbook decks"
  title="The Deck Components"
  subtitle="Every kind of slide in one deck, at the size the back row reads"
  byline="CS 461, 462, 463: the instruction team"
/>

<StatementSlide kicker="The auditorium rule">
  One idea per slide, set large enough for the last row to read.
</StatementSlide>

<Slide kicker="Slide" title="What a deck file holds">
  <ul>
    <li>One <code>.astro</code> file per deck, under <code>src/decks/</code></li>
    <li class="fragment">One <code>&lt;section&gt;</code> per slide, usually a component</li>
    <li class="fragment">No speaker notes: what the room needs is on the slide</li>
    <li class="fragment">Served at <code>/decks/&lt;file name&gt;/</code></li>
  </ul>
</Slide>

<TwoColumnSlide kicker="Two columns" title="What holds a deck to the rules" divider>
  <div slot="left">
    <h3>The room sees</h3>
    <ul>
      <li>A light slide, whatever the laptop's theme</li>
      <li>Body text at 32px or more</li>
      <li>A progress bar along the foot</li>
    </ul>
  </div>
  <div slot="right">
    <h3>The checks catch</h3>
    <ul>
      <li>An em dash, on any slide</li>
      <li>A calendar date or an academic year</li>
      <li>A banned word in the slide text</li>
    </ul>
  </div>
</TwoColumnSlide>

<ImageSlide
  kicker="Image"
  title="A design sprint in five days"
  src={sprint}
  alt="The five days of a design sprint: map, sketch, decide, prototype, and test"
  caption="Text inside an image has to be as large as the slide's own, or the back row loses it."
/>

<Slide kicker="Story map" title="A story map at seven columns" wide>
  <StoryMap
    backbone={[
      "Sign up",
      "Find a book",
      "Reserve it",
      "Pick it up",
      "Renew it",
      "Return it",
      "? Get reminders",
    ]}
    releases={[
      {
        goal: "End to end, once",
        name: "Walking skeleton",
        stories: [
          "Student ID sign-in",
          "Search by title",
          "Place a hold",
          "Show hold at desk",
          undefined,
          "Scan it in",
          undefined,
        ],
      },
      {
        goal: "Staff stop using paper",
        name: "Release 1",
        stories: [
          undefined,
          ["Filter by subject", "? Browse new arrivals"],
          "Cancel a hold",
          "Text when ready",
          "Renew online",
          undefined,
          "Due soon email",
        ],
      },
      {
        name: "Later",
        stories: [
          "? Library card sign-in",
          { assumed: true, text: "Suggest books" },
          undefined,
          "Locker pickup",
          "Renew in the app",
          "Drop box return",
          "? Push alerts",
        ],
      },
    ]}
  />
</Slide>

<Slide kicker="Story map" title="A story map with its parts labeled" wide>
  <StoryMap
    backbone={["Find a book", "Reserve it", "Pick it up", "Return it"]}
    releases={[
      {
        name: "Walking skeleton",
        stories: ["Search by title", "Place a hold", "Show hold at desk", "Scan it in"],
      },
      {
        name: "Release 1",
        stories: [
          "Filter by subject",
          "Cancel a hold",
          "Text when ready",
          ["Drop box return", "? Due soon email"],
        ],
      },
    ]}
    callouts={[
      { at: "backbone", term: "Backbone", text: "what the user does, in order" },
      { at: "row", row: 0, term: "Walking skeleton", text: "one thin path through every column" },
      { at: "line", row: 1, term: "Release line", text: "everything above it ships first" },
      { at: "card", row: 1, column: 3, item: 1, term: "A card", text: "one story" },
    ]}
    stepped
  />
</Slide>

<Slide kicker="Decision list" title="Decisions sorted, the hard ones explained" wide>
  <DecisionList
    decisions={[
      { text: "Search by title or by subject first" },
      {
        cost: "Moving every account to a new sign-in",
        hard: true,
        text: "Sign in with student IDs",
        validator: { what: "the ID service allows a new client", who: "Library IT" },
      },
      { text: "Chart library for the staff dashboard" },
      {
        cost: "Migrating every loan already recorded",
        hard: true,
        text: "Where borrowing history is stored",
        validator: { what: "the retention rule for patron records", who: "Partner" },
      },
      { text: "Text or email when a hold is ready" },
    ]}
    stepped
  />
</Slide>

<Slide kicker="Safety net" title="A team's checks, and whether each would catch a bad change" wide>
  <SafetyNet
    checks={[
      { catches: "partly", check: "Tests on the paths that matter", have: "Search tests; none on holds or renewals" },
      { catches: "yes", check: "CI on every pull request", have: "Lint and unit tests, required to merge" },
      { catches: "no", check: "Review on hard-to-undo paths", have: "None: anything merges" },
      { catches: "partly", check: "Staging or preview", have: "A preview for each pull request" },
      { catches: "no", check: "A rollback you've tried", have: "Never tried" },
    ]}
    stepped
  />
</Slide>

<PeopleSlide
  kicker="People"
  title="Who is in the room"
  people={[
    { name: "Kirsten Winters", src: kirstenWinters },
    { name: "Alex Ulbrich", src: alexUlbrich },
  ]}
>
  <p>Portraits sit beside the text, cropped square.</p>
</PeopleSlide>

<Slide kicker="Grade grid" title="One term of the grade grid" wide>
  <GradeGrid term="winter" />
</Slide>

<Slide kicker="Term sessions" title="A term's In class lines" wide>
  <TermSessions term="winter" />
</Slide>

<Slide kicker="Term sessions" title="A few weeks, several lines" wide>
  <TermSessions term="spring" from={1} to={3} rows={["Due", "In class"]} />
</Slide>

<QrSlide kicker="QR code" title="A link the room scans" url={handbook}>
  <p>Generated at build time; the address is written out beside it.</p>
</QrSlide>

<FrameSlide src="/tools/" label="The instructor tools" />

<SeatingMap teams={40} kicker="Seating map" title="Teams placed in the auditorium" />

<Slide kicker="Adding a component" title="A new kind of slide is one file">
  <ol>
    <li>Add a file to <code>src/components/deck/</code> that renders <code>&lt;Slide&gt;</code></li>
    <li>Describe its props in a short comment at the top</li>
    <li>Import it in the deck and use it once in this sample</li>
  </ol>
</Slide>
