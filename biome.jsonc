{
  "$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
  "extends": ["ultracite/biome/core"],
  // Biome covers the code: the scripts, the Astro config and
  // components, the content schema, and the JSON configs. Everything under
  // canvas/ is HTML pasted into Canvas and public/ is served verbatim; neither
  // is code, and reformatting them only makes the Canvas diff unreadable.
  // canvas-export/ is the generated paste kit, gitignored.
  "files": {
    "includes": ["!canvas", "!canvas-export", "!public", "!dist", "!.astro"]
  },
  "linter": {
    "rules": {
      "style": {
        // The rule has no fix: turning it on means naming every group and
        // rewriting each match site that reads one by index, the guard hooks'
        // included, for no change in behavior.
        "useNamedCaptureGroup": "off",
        // getElementById takes an id as it is. querySelector needs CSS.escape
        // on each one and throws on an id from a URL hash that starts with a
        // digit, which term-tabs.js reads.
        "useDomQuerySelector": "off"
      },
      "suspicious": {
        // Each exemption degrades safely: @page, print-color-adjust and
        // box-decoration-break only shape the printed PDFs, text-wrap falls
        // back to normal wrapping, and ui-monospace sits ahead of fallbacks.
        "useBaseline": {
          "level": "error",
          "options": {
            "allowAtRules": ["page"],
            "allowProperties": [
              "box-decoration-break",
              "print-color-adjust",
              "text-wrap"
            ],
            "allowPropertyValues": { "font-family": ["ui-monospace"] }
          }
        }
      }
    }
  },
  // The Markdown formatter pads every table cell to its column's widest row,
  // so one edited row in AGENTS.md rewrites the whole table.
  "markdown": {
    "formatter": { "enabled": false }
  },
  "overrides": [
    {
      // Astro components are PascalCase by Astro's own convention, and an
      // empty frontmatter fence is how a template-only component looks.
      "includes": ["**/*.svelte", "**/*.astro", "**/*.vue"],
      "linter": {
        "rules": {
          "style": {
            "useConst": "off",
            "useImportType": "off",
            "useFilenamingConvention": "off"
          },
          "correctness": {
            "noUnusedVariables": "off",
            "noUnusedImports": "off"
          },
          "suspicious": {
            "noEmptySource": "off"
          }
        }
      }
    },
    {
      // Qualtrics pipes text as ${e://Field/Name}: in the survey wording and
      // the generator it is data, never a template literal gone wrong.
      "includes": [
        "src/lib/tools/**",
        "src/data/peer-evaluation.mjs",
        "src/data/partner-evaluation.mjs"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noTemplateCurlyInString": "off"
          }
        }
      }
    },
    {
      // The validators are one-shot CLI scripts over a few dozen files, and
      // the tests run once per run. Hoisting every regex out of its loop buys
      // nothing and moves the pattern away from the line that explains it.
      "includes": ["scripts/**", "**/*.test.mjs"],
      "linter": {
        "rules": {
          "performance": {
            "useTopLevelRegex": "off"
          }
        }
      }
    },
    {
      // The tools read files in the browser and never upload them
      // (docs/agents/tools.md). These are the browser's request APIs, so a
      // tool that calls one has started sending something off the page. The
      // rule sees a bare name only: not window.fetch, and not an Astro
      // page's <script>, which Biome does not lint.
      "includes": [
        "src/pages/tools/**",
        "src/components/tools/**",
        "src/lib/tools/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "EventSource": "A tool never sends a file off the page; read it in the browser.",
                  "fetch": "A tool never sends a file off the page; read it in the browser.",
                  "WebSocket": "A tool never sends a file off the page; read it in the browser.",
                  "XMLHttpRequest": "A tool never sends a file off the page; read it in the browser."
                }
              }
            }
          }
        }
      }
    }
  ]
}
