{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "extends": ["ultracite/biome/core"],
  // Biome covers the code: the scripts, the Astro config and
  // components, the content schema, and the JSON configs. Everything under
  // canvas/ is HTML pasted into Canvas and public/ is served verbatim; neither
  // is code, and reformatting them only makes the Canvas diff unreadable.
  // canvas-export/ is the generated paste kit, gitignored.
  "files": {
    "includes": ["!canvas", "!canvas-export", "!public", "!dist", "!.astro"]
  },
  "linter": {
    "rules": {
      "suspicious": {
        // Biome 2.5.14 infers that RegExp.prototype.exec never returns null,
        // so it flags every `if (match)` after an exec as always truthy.
        // Taking its fix crashes the git guard and the sidebar validator on
        // input that does not match. Off until the inference is fixed.
        "noUnnecessaryConditions": "off"
      }
    }
  },
  "overrides": [
    {
      // Astro components are PascalCase by Astro's own convention, and an
      // empty frontmatter fence is how a template-only component looks.
      "includes": ["**/*.svelte", "**/*.astro", "**/*.vue"],
      "linter": {
        "rules": {
          "style": {
            "useConst": "off",
            "useImportType": "off",
            "useFilenamingConvention": "off"
          },
          "correctness": {
            "noUnusedVariables": "off",
            "noUnusedImports": "off"
          },
          "suspicious": {
            "noEmptySource": "off"
          }
        }
      }
    },
    {
      // The validators are one-shot CLI scripts over a few dozen files.
      // Hoisting every regex out of its loop buys nothing and moves the
      // pattern away from the line that explains it.
      "includes": ["scripts/**"],
      "linter": {
        "rules": {
          "performance": {
            "useTopLevelRegex": "off"
          }
        }
      }
    }
  ]
}
